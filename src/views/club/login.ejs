<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title><%= title %></title>
  <link rel="stylesheet" href="/club/styles.css">
  <link rel="stylesheet" href="/club/premium.css">
  <link rel="stylesheet" href="/club/login-logo.css">
  <link rel="stylesheet" href="/club/operations.css">
</head>
<body class="auth-body">
  <main class="auth-shell auth-shell-premium">
    <section class="auth-hero">
      <div class="auth-glow auth-glow-one"></div>
      <div class="auth-glow auth-glow-two"></div>
      <div class="auth-hero-inner">
        <div class="auth-brand auth-brand-large auth-brand-logo-only">
          <% if (branding?.logoUrl) { %>
            <img class="auth-brand-logo-image" src="<%= branding.logoUrl %>" alt="Logo klubu">
          <% } else { %>
            <div class="crest crest-large">Z</div>
          <% } %>
        </div>
        <div class="auth-hero-copy">
          <span class="auth-kicker">Zastal · Marketing Center</span>
          <h1>Centrum operacyjne<br>dnia meczowego.</h1>
          <p>Materiały, zdjęcia i publikacje prowadzone w jednym, uporządkowanym procesie — od zapowiedzi do ostatniego gwizdka.</p>
        </div>
        <div class="auth-feature-row">
          <div><b>Planowanie</b><span>Harmonogram i briefy</span></div>
          <div><b>Produkcja</b><span>Materiały meczowe</span></div>
          <div><b>Archiwum</b><span>Zdjęcia i eksporty</span></div>
        </div>
      </div>
    </section>
    <section class="auth-panel">
      <div class="auth-panel-inner">
        <div class="auth-mobile-brand auth-brand-logo-only">
          <% if (branding?.logoUrl) { %>
            <img class="auth-brand-logo-image" src="<%= branding.logoUrl %>" alt="Logo klubu">
          <% } else { %>
            <div class="crest">Z</div>
          <% } %>
        </div>
        <div class="auth-copy auth-copy-premium">
          <span class="eyebrow">Panel zespołu</span>
          <h2>Zaloguj się</h2>
          <p>Użyj danych przypisanych do Twojego konta klubowego.</p>
        </div>
        <% if (error) { %><div class="auth-error"><span>!</span><%= error %></div><% } %>
        <form method="post" action="/login" class="auth-form auth-form-premium">
          <label><span>Adres e-mail</span><div class="auth-input-wrap"><input name="email" type="email" autocomplete="username" placeholder="imie@zastal.pl" required autofocus></div></label>
          <label><span>Hasło</span><div class="auth-input-wrap"><input name="password" type="password" autocomplete="current-password" placeholder="Wpisz hasło" required></div></label>
          <button class="primary auth-submit auth-submit-premium" type="submit"><span>Wejdź do centrum</span><span aria-hidden="true">↗</span></button>
        </form>
        <div class="auth-security-note"><span class="status-dot"></span> System klubowy · dostęp autoryzowany</div>
      </div>
    </section>
  </main>
</body>
</html>
