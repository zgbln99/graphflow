<!doctype html>
<html lang="pl" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="noindex,nofollow">
  <title><%= title %></title>
  <link rel="icon" href="<%= (branding && branding.logoUrl) ? branding.logoUrl : 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22%3E%3Crect width=%2232%22 height=%2232%22 fill=%22%230b0d0d%22/%3E%3Ccircle cx=%2216%22 cy=%2216%22 r=%229%22 fill=%22none%22 stroke=%22%230d8f4f%22 stroke-width=%222%22/%3E%3Cpath d=%22M7 16h18M16 7c-3 4-3 14 0 18M16 7c3 4 3 14 0 18%22 fill=%22none%22 stroke=%22%230d8f4f%22 stroke-width=%221.4%22/%3E%3C/svg%3E' %>">
  <link rel="stylesheet" href="/vendor/tabler/css/tabler.min.css">
  <link rel="stylesheet" href="<%= asset('/club/brand.css') %>">
</head>
<body class="d-flex flex-column">
  <%- include('_icons') %>

  <div class="page page-center">
    <div class="container container-tight py-4">

      <div class="text-center mb-4">
        <% if (branding && branding.logoUrl) { %>
          <img class="login-logo" src="<%= branding.logoUrl %>" alt="Logo klubu">
        <% } else { %>
          <div class="navbar-brand-club justify-content-center">
            <span class="wordmark text-center"><b>ZASTAL</b><span>MARKETING CENTER</span></span>
          </div>
        <% } %>
      </div>

      <div class="card card-md">
        <div class="card-body">
          <h2 class="h2 text-center mb-1">Zaloguj się</h2>
          <p class="text-secondary text-center mb-4">Panel działu marketingu</p>

          <% if (error) { %>
            <div class="alert alert-danger" role="alert">
              <div class="d-flex">
                <div class="me-2"><svg class="icon"><use href="#i-alert"></use></svg></div>
                <div><%= error %></div>
              </div>
            </div>
          <% } %>

          <form method="post" action="/login" autocomplete="on" novalidate>
            <div class="mb-3">
              <label class="form-label" for="email">Adres e-mail</label>
              <input id="email" name="email" type="email" class="form-control" placeholder="imie@zastal.pl"
                     autocomplete="username" required autofocus>
            </div>
            <div class="mb-3">
              <label class="form-label" for="password">Hasło</label>
              <input id="password" name="password" type="password" class="form-control" placeholder="Hasło"
                     autocomplete="current-password" required>
            </div>
            <div class="form-footer">
              <button type="submit" class="btn btn-primary w-100">Zaloguj się</button>
            </div>
          </form>
        </div>
      </div>

      <div class="text-center text-secondary mt-3">
        Konta zakłada administrator systemu.
      </div>
    </div>
  </div>
</body>
</html>
