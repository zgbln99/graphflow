<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title><%= title %></title>
  <link rel="stylesheet" href="/club/styles.css">
  <link rel="stylesheet" href="/club/premium.css">
  <link rel="stylesheet" href="/club/login-logo.css">
  <link rel="stylesheet" href="/club/operations.css">
</head>
<body class="auth-body login-v4-body">
  <main class="login-v4">
    <header class="login-v4-header">
      <div class="login-v4-brand">
        <% if (branding?.logoUrl) { %>
          <img src="<%= branding.logoUrl %>" alt="Logo klubu">
        <% } else { %>
          <div class="crest">Z</div>
        <% } %>
      </div>
      <div class="login-v4-context"><span>Marketing Center</span><b>Sezon 2026 / 27</b></div>
    </header>

    <section class="login-v4-main">
      <div class="login-v4-form-column">
        <div class="login-v4-heading"><span>System wewnętrzny</span><h1>Zaloguj się do panelu</h1><p>Wprowadź dane swojego konta klubowego.</p></div>
        <% if (error) { %><div class="auth-error"><span>!</span><%= error %></div><% } %>
        <form method="post" action="/login" class="login-v4-form">
          <label><span>E-mail</span><input name="email" type="email" autocomplete="username" placeholder="imie@zastal.pl" required autofocus></label>
          <label><span>Hasło</span><input name="password" type="password" autocomplete="current-password" placeholder="Wpisz hasło" required></label>
          <button class="login-v4-submit" type="submit"><span>Zaloguj się</span><span aria-hidden="true">→</span></button>
        </form>
        <div class="login-v4-note"><span class="status-dot"></span>Dostęp wyłącznie dla pracowników klubu</div>
      </div>
    </section>

    <footer class="login-v4-footer"><span>Zastal Zielona Góra</span><span>Marketing Center · system wewnętrzny</span></footer>
  </main>
</body>
</html>
