<!doctype html>
<html lang="pl" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="noindex,nofollow">
  <title><%= title %></title>
  <link rel="icon" href="<%= (branding && branding.logoUrl) ? branding.logoUrl : '/favicon.ico' %>">
  <link rel="stylesheet" href="/vendor/tabler/css/tabler.min.css">
  <link rel="stylesheet" href="/club/brand.css?v=7">
</head>
<body class="app-body">
<%
  const role = user.role || 'social';
  const can = (...roles) => roles.includes(role);
  const initials = String(user.displayName || user.email)
    .split(' ').map(part => part[0]).slice(0, 2).join('').toUpperCase();
  const roleLabels = { admin: 'Administrator', designer: 'Grafik', social: 'Social media', photographer: 'Fotograf' };
  const badgeByState = { ok: 'bg-green-lt', work: 'bg-yellow-lt', todo: 'bg-secondary-lt', late: 'bg-red-lt' };
  const d = dashboard;
  const m = d.nextMatch;
  const ready = d.facts.find(f => f.label === 'Materiały gotowe');
  // Układ nawigacji: pasek górny (wariant wybrany przez właściciela projektu).
  const partials = { branding, user, role, can, initials, roleLabels, d, integrations };
%>
<%- include('_icons') %>

<div class="page">
  <!-- ======================= NAWIGACJA ======================= -->
  <header class="navbar navbar-expand-md d-print-none" data-bs-theme="dark">
    <div class="container-fluid">
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topbar-menu"
              aria-controls="topbar-menu" aria-expanded="false" aria-label="Menu">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="navbar-brand navbar-brand-club me-3 me-lg-4"><%- include('_brand', partials) %></div>

      <div class="navbar-nav flex-row order-md-last ms-auto align-items-center">
        <div class="nav-item status-magazyn d-none d-md-flex me-3">
          <span class="status status-warning status-lite" title="Magazyn zdjęć nieskonfigurowany">
            <span class="status-dot"></span>Magazyn
          </span>
        </div>
        <div class="d-flex align-items-center"><%- include('_user', partials) %></div>
      </div>

      <div class="collapse navbar-collapse" id="topbar-menu">
        <ul class="navbar-nav"><%- include('_nav-items', partials) %></ul>
      </div>
    </div>
  </header>

  <!-- ======================= OBSZAR ROBOCZY ======================= -->
  <div class="page-wrapper">
    <div class="page-header d-print-none">
      <div class="container-fluid">
        <div class="row g-2 align-items-center">
          <div class="col">
            <div class="page-pretitle" id="eyebrow">Sezon <%= d.season %></div>
            <h2 class="page-title" id="page-title">Dashboard</h2>
          </div>
          <div class="col-auto ms-auto">
            <div class="btn-list align-items-center">
              <select class="form-select form-select-sm w-auto" aria-label="Sezon">
                <option><%= d.season %></option>
              </select>
              <% if (role === 'admin') { %>
                <button class="btn btn-primary" id="new-action" type="button">
                  <svg class="icon"><use href="#i-plus"></use></svg>Nowy mecz
                </button>
              <% } else if (role === 'photographer') { %>
                <button class="btn btn-primary" id="new-action" type="button">
                  <svg class="icon"><use href="#i-upload"></use></svg>Prześlij zdjęcia
                </button>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="page-body">

      <!-- ==================== DASHBOARD ==================== -->
      <div id="view-dashboard" class="view active-view">
        <div class="container-fluid">
          <div class="row row-cards">

            <!-- Najbliższy mecz -->
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Najbliższy mecz</h3>
                  <div class="card-actions btn-actions">
                    <span class="badge bg-green-lt me-2"><%= m.competition %> · <%= m.round %></span>
                    <button class="btn btn-primary btn-sm" type="button" data-view="matches">Otwórz mecz</button>
                  </div>
                </div>
                <div class="card-body">
                  <div class="fixture-title mb-3">
                    <span class="<%= m.clubSide === 'home' ? 'club' : '' %>"><%= m.home %></span>
                    <span class="text-secondary mx-2">—</span>
                    <span class="<%= m.clubSide === 'away' ? 'club' : '' %>"><%= m.away %></span>
                  </div>
                  <div class="datagrid">
                    <div class="datagrid-item">
                      <div class="datagrid-title">Termin</div>
                      <div class="datagrid-content"><%= m.dateLabel %> · <%= m.time %></div>
                    </div>
                    <div class="datagrid-item">
                      <div class="datagrid-title">Hala</div>
                      <div class="datagrid-content"><%= m.arena %></div>
                    </div>
                    <div class="datagrid-item d-none d-sm-block">
                      <div class="datagrid-title">Charakter</div>
                      <div class="datagrid-content"><%= m.venueType %></div>
                    </div>
                    <% d.facts.forEach((fact, index) => { %>
                      <div class="datagrid-item <%= index > 1 ? 'd-none d-sm-block' : '' %>">
                        <div class="datagrid-title"><%= fact.label %></div>
                        <div class="datagrid-content"><%= fact.value %><% if (fact.unit) { %> <%= fact.unit %><% } %></div>
                      </div>
                    <% }) %>
                  </div>
                </div>
                <div class="card-footer">
                  <div class="row align-items-center g-2">
                    <div class="col-auto text-secondary small">Pakiet materiałów meczowych</div>
                    <div class="col">
                      <div class="progress progress-sm">
                        <div class="progress-bar bg-green" style="width: 25%" role="progressbar"
                             aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">
                          <span class="visually-hidden">25% gotowych</span>
                        </div>
                      </div>
                    </div>
                    <div class="col-auto text-secondary small"><%= ready ? ready.value : '' %> gotowych</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Harmonogram materiałów -->
            <div class="col-lg-8">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Harmonogram materiałów</h3>
                  <div class="card-actions">
                    <div class="btn-group btn-group-sm" role="group" aria-label="Zakres">
                      <input type="radio" class="btn-check" name="rundown-range" id="range-match" checked>
                      <label for="range-match" class="btn">Ten mecz</label>
                      <input type="radio" class="btn-check" name="rundown-range" id="range-week">
                      <label for="range-week" class="btn">Tydzień</label>
                      <input type="radio" class="btn-check" name="rundown-range" id="range-late">
                      <label for="range-late" class="btn">Zaległe</label>
                    </div>
                  </div>
                </div>
                <div class="table-responsive">
                  <table class="table table-vcenter card-table">
                    <thead>
                      <tr>
                        <th class="w-1">Godz.</th>
                        <th>Materiał</th>
                        <th>Format</th>
                        <th>Odpowiedzialny</th>
                        <th class="w-1">Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% d.schedule.forEach(block => { %>
                        <tr class="bg-surface-secondary">
                          <td colspan="4" class="text-uppercase small fw-bold <%= block.matchday ? 'text-green' : 'text-secondary' %>">
                            <%= block.day %>
                          </td>
                          <td class="text-secondary small text-nowrap"><%= block.note %></td>
                        </tr>
                        <% block.items.forEach(item => { %>
                          <tr>
                            <td class="text-secondary text-nowrap"><%= item.time %></td>
                            <td>
                              <div><%= item.name %></div>
                              <div class="text-secondary small"><%= item.meta %></div>
                            </td>
                            <td class="text-secondary text-nowrap"><%= item.format %></td>
                            <td class="text-secondary"><%= item.owner %></td>
                            <td><span class="badge <%= badgeByState[item.state] %>"><%= item.status %></span></td>
                          </tr>
                        <% }) %>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- Kolumna kontrolna -->
            <div class="col-lg-4">
              <div class="row row-cards">
                <div class="col-12">
                  <div class="card">
                    <div class="card-header">
                      <h3 class="card-title">Wymaga decyzji</h3>
                      <div class="card-actions"><span class="badge bg-red-lt"><%= d.blockers.length %></span></div>
                    </div>
                    <div class="list-group list-group-flush">
                      <% d.blockers.forEach(item => { %>
                        <div class="list-group-item">
                          <div class="row align-items-center g-2">
                            <div class="col-auto">
                              <span class="status-dot <%= item.level === 'urgent' ? 'status-dot-animated bg-red' : 'bg-yellow' %>"></span>
                            </div>
                            <div class="col text-truncate">
                              <div class="text-truncate"><%= item.title %></div>
                              <div class="text-secondary small text-truncate"><%= item.detail %></div>
                            </div>
                            <div class="col-auto text-secondary small"><%= item.due %></div>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </div>

                <div class="col-12">
                  <div class="card">
                    <div class="card-header">
                      <h3 class="card-title">Foldery zdjęć meczu</h3>
                      <div class="card-actions"><a href="#" class="btn btn-link btn-sm" data-view="library">Biblioteka</a></div>
                    </div>
                    <div class="list-group list-group-flush">
                      <% d.folders.items.forEach(folder => { %>
                        <div class="list-group-item d-flex align-items-center">
                          <svg class="icon me-2 text-secondary"><use href="#i-folder"></use></svg>
                          <span class="flex-fill text-truncate"><%= folder.name %></span>
                          <span class="text-secondary small me-2"><%= folder.updated %></span>
                          <span class="badge bg-secondary-lt"><%= folder.count %></span>
                        </div>
                      <% }) %>
                    </div>
                    <% if (!d.folders.connected) { %>
                      <div class="card-footer text-secondary small">
                        Magazyn MEGA S3 nie jest jeszcze podłączony — liczby pochodzą z indeksu lokalnego.
                      </div>
                    <% } %>
                  </div>
                </div>

                <div class="col-12">
                  <div class="card">
                    <div class="card-header">
                      <h3 class="card-title">Ostatnie eksporty</h3>
                      <div class="card-actions"><a href="#" class="btn btn-link btn-sm" data-view="history">Historia</a></div>
                    </div>
                    <div class="list-group list-group-flush">
                      <% d.exports.forEach(item => { %>
                        <div class="list-group-item d-flex align-items-center">
                          <div class="flex-fill text-truncate">
                            <div class="text-truncate"><%= item.name %></div>
                            <div class="text-secondary small text-truncate"><%= item.context %> · <%= item.format %></div>
                          </div>
                          <span class="text-secondary small ms-2"><%= item.time %></span>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Materiały spoza kalendarza meczowego -->
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Poza meczem</h3>
                  <div class="card-actions"><a href="#" class="btn btn-link btn-sm" data-view="other">Inne grafiki</a></div>
                </div>
                <div class="table-responsive">
                  <table class="table table-vcenter card-table">
                    <thead>
                      <tr><th class="w-1">Termin</th><th>Materiał</th><th>Format</th><th class="w-1">Status</th></tr>
                    </thead>
                    <tbody>
                      <% d.offMatch.forEach(item => { %>
                        <tr>
                          <td class="text-secondary text-nowrap"><%= item.due %></td>
                          <td><%= item.name %></td>
                          <td class="text-secondary"><%= item.context %></td>
                          <td><span class="badge <%= badgeByState[item.state] %>"><%= item.status %></span></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- ==================== MECZE ==================== -->
      <div id="view-matches" class="view">
        <div class="container-fluid">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Mecze sezonu <%= d.season %></h3>
              <div class="card-actions">
                <div class="input-group input-group-flat w-auto">
                  <span class="input-group-text"><svg class="icon"><use href="#i-search"></use></svg></span>
                  <input type="search" class="form-control" placeholder="Szukaj meczu…" aria-label="Szukaj meczu">
                </div>
              </div>
            </div>
            <div class="table-responsive">
              <table class="table table-vcenter card-table table-hover">
                <thead>
                  <tr><th>Mecz</th><th>Termin</th><th>Wynik</th><th>Status</th><th>Materiały</th><th class="w-1"></th></tr>
                </thead>
                <tbody>
                  <tr data-match="zastal-anwil" style="cursor:pointer">
                    <td><div><span class="text-green">Zastal</span> — Anwil Włocławek</div>
                        <div class="text-secondary small">Hala CRS, Zielona Góra · kolejka 3</div></td>
                    <td class="text-nowrap">27.09.2026<div class="text-secondary small">18:00</div></td>
                    <td class="fw-bold">92 : 81</td>
                    <td><span class="badge bg-green-lt">Rozegrany</span></td>
                    <td class="text-secondary">8 / 8</td>
                    <td><button class="btn btn-icon btn-ghost-secondary" aria-label="Więcej"><svg class="icon"><use href="#i-more"></use></svg></button></td>
                  </tr>
                  <tr>
                    <td><div>Śląsk Wrocław — <span class="text-green">Zastal</span></div>
                        <div class="text-secondary small">Hala Orbita, Wrocław · kolejka 4</div></td>
                    <td class="text-nowrap">04.10.2026<div class="text-secondary small">17:30</div></td>
                    <td class="text-secondary">— : —</td>
                    <td><span class="badge bg-yellow-lt">W przygotowaniu</span></td>
                    <td class="text-secondary">2 / 8</td>
                    <td><button class="btn btn-icon btn-ghost-secondary" aria-label="Więcej"><svg class="icon"><use href="#i-more"></use></svg></button></td>
                  </tr>
                  <tr>
                    <td><div><span class="text-green">Zastal</span> — King Szczecin</div>
                        <div class="text-secondary small">Hala CRS, Zielona Góra · kolejka 5</div></td>
                    <td class="text-nowrap">11.10.2026<div class="text-secondary small">16:00</div></td>
                    <td class="text-secondary">— : —</td>
                    <td><span class="badge bg-secondary-lt">Zaplanowany</span></td>
                    <td class="text-secondary">0 / 7</td>
                    <td><button class="btn btn-icon btn-ghost-secondary" aria-label="Więcej"><svg class="icon"><use href="#i-more"></use></svg></button></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== CENTRUM MECZU ==================== -->
      <div id="view-match" class="view">
        <div class="container-fluid">
          <div class="row row-cards">
            <div class="col-lg-4">
              <div class="card">
                <div class="card-body text-center">
                  <div class="text-secondary text-uppercase small">Wynik końcowy</div>
                  <div class="display-6 fw-bold my-2">92 : 81</div>
                  <div>Zastal — Anwil Włocławek</div>
                  <div class="text-secondary small mt-2">27.09.2026 · 18:00<br>Hala CRS, Zielona Góra</div>
                </div>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="card">
                <div class="card-header"><h3 class="card-title">Dane meczu</h3></div>
                <div class="card-body">
                  <div class="datagrid">
                    <div class="datagrid-item"><div class="datagrid-title">Rozgrywki</div><div class="datagrid-content">ORLEN Basket Liga</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">Kolejka</div><div class="datagrid-content">3</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">Sezon</div><div class="datagrid-content"><%= d.season %></div></div>
                  </div>
                </div>
                <div class="card-footer"><button class="btn btn-sm w-100" type="button">Edytuj dane meczu</button></div>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="card">
                <div class="card-header"><h3 class="card-title">Foldery zdjęć</h3></div>
                <div class="list-group list-group-flush">
                  <% d.folders.items.forEach(folder => { %>
                    <a href="#" class="list-group-item list-group-item-action d-flex align-items-center">
                      <svg class="icon me-2 text-secondary"><use href="#i-folder"></use></svg>
                      <span class="flex-fill"><%= folder.name %></span>
                      <span class="badge bg-secondary-lt"><%= folder.count %></span>
                    </a>
                  <% }) %>
                </div>
                <div class="card-footer"><button class="btn btn-sm w-100" type="button">Zarządzaj folderami</button></div>
              </div>
            </div>

            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Grafiki meczowe</h3>
                  <div class="card-actions">
                    <button class="btn btn-primary btn-sm" type="button"><svg class="icon"><use href="#i-plus"></use></svg>Dodaj grafikę</button>
                  </div>
                </div>
                <div class="card-body">
                  <div class="row row-cards" id="graphic-grid"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== EDYTOR ==================== -->
      <div id="view-editor" class="view">
        <div class="container-fluid">
          <div class="row row-cards">
            <div class="col-lg-3">
              <div class="card">
                <div class="card-header">
                  <ul class="nav nav-tabs card-header-tabs" role="tablist">
                    <li class="nav-item"><a href="#" class="nav-link active">Edytor</a></li>
                    <li class="nav-item"><a href="#" class="nav-link">Ustawienia</a></li>
                    <li class="nav-item"><a href="#" class="nav-link">Historia</a></li>
                  </ul>
                </div>
                <div class="card-body">
                  <h4 id="editor-template-name" class="mb-3">Final Score</h4>
                  <div id="dynamic-fields"></div>
                </div>
              </div>
            </div>

            <div class="col-lg-6">
              <div class="card">
                <div class="card-header">
                  <div class="btn-list">
                    <button class="btn btn-icon btn-sm" type="button" aria-label="Cofnij"><svg class="icon"><use href="#i-undo"></use></svg></button>
                    <button class="btn btn-icon btn-sm" type="button" aria-label="Ponów"><svg class="icon"><use href="#i-redo"></use></svg></button>
                  </div>
                  <div class="card-actions text-secondary small" id="canvas-size">1080 × 1350</div>
                </div>
                <div class="card-body">
                  <div class="canvas-stage bg-dark rounded p-2" style="height:min(60vh,640px)">
                    <canvas id="design-canvas" width="540" height="675"></canvas>
                  </div>
                </div>
                <div class="card-footer">
                  <div class="row align-items-center">
                    <div class="col text-secondary small">Podgląd 68% — eksport zawsze w rozdzielczości szablonu</div>
                    <div class="col-auto"><button class="btn btn-primary btn-sm" type="button">Eksportuj PNG</button></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-lg-3">
              <div class="card">
                <div class="card-header">
                  <div>
                    <h3 class="card-title">Zdjęcia z meczu</h3>
                    <div class="text-secondary small">Foldery przypisane do spotkania</div>
                  </div>
                  <div class="card-actions">
                    <button class="btn btn-icon btn-sm" type="button" aria-label="Odśwież"><svg class="icon"><use href="#i-refresh"></use></svg></button>
                  </div>
                </div>
                <div class="card-body">
                  <div class="btn-group w-100 mb-3" role="group">
                    <input type="radio" class="btn-check" name="photo-folder" id="pf-all" checked>
                    <label for="pf-all" class="btn btn-sm">Wszystkie</label>
                    <input type="radio" class="btn-check" name="photo-folder" id="pf-photo">
                    <label for="pf-photo" class="btn btn-sm">Photo</label>
                    <input type="radio" class="btn-check" name="photo-folder" id="pf-sel">
                    <label for="pf-sel" class="btn btn-sm">Wybrane</label>
                  </div>
                  <div class="row g-2 scroll-y" id="photo-grid" style="max-height:min(48vh,460px)"></div>
                </div>
                <div class="card-footer">
                  <button class="btn btn-sm w-100" type="button"><svg class="icon"><use href="#i-upload"></use></svg>Prześlij zdjęcia</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== SZABLONY ==================== -->
      <div id="view-templates" class="view">
        <div class="container-fluid">
          <div class="row row-cards">
            <div class="col-lg-4">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Szablony</h3>
                  <div class="card-actions">
                    <button class="btn btn-primary btn-sm" id="create-template" type="button"><svg class="icon"><use href="#i-plus"></use></svg>Nowy</button>
                  </div>
                </div>
                <div class="list-group list-group-flush" id="template-list"></div>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="card">
                <div class="card-header"><h3 class="card-title">Warstwy</h3></div>
                <div class="list-group list-group-flush" id="layers-list"></div>
                <div class="card-footer">
                  <button id="add-layer" class="btn btn-sm w-100" type="button"><svg class="icon"><use href="#i-plus"></use></svg>Dodaj warstwę</button>
                </div>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="card">
                <div class="card-header"><h3 class="card-title">Właściwości warstwy</h3></div>
                <div class="card-body" id="layer-properties"><p class="text-secondary">Wybierz warstwę z listy.</p></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== INNE GRAFIKI ==================== -->
      <div id="view-other" class="view">
        <div class="container-fluid">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Inne grafiki</h3>
              <div class="card-actions">
                <button class="btn btn-primary btn-sm" type="button"><svg class="icon"><use href="#i-plus"></use></svg>Nowa grafika</button>
              </div>
            </div>
            <div class="card-body">
              <div class="row row-cards" id="other-grid"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== BIBLIOTEKA ZDJĘĆ ==================== -->
      <div id="view-library" class="view">
        <div class="container-fluid">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Biblioteka zdjęć</h3>
              <div class="card-actions">
                <button class="btn btn-primary btn-sm" type="button"><svg class="icon"><use href="#i-upload"></use></svg>Prześlij zdjęcia</button>
              </div>
            </div>
            <div class="card-body">
              <div class="row g-2" id="library-grid"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== HISTORIA ==================== -->
      <div id="view-history" class="view">
        <div class="container-fluid">
          <div class="card">
            <div class="card-header"><h3 class="card-title">Historia eksportów</h3></div>
            <div class="table-responsive">
              <table class="table table-vcenter card-table">
                <thead><tr><th class="w-1">Podgląd</th><th>Grafika</th><th>Mecz / typ</th><th>Data</th><th>Format</th><th>Użytkownik</th></tr></thead>
                <tbody id="history-body"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== MONITORING SOCIAL ==================== -->
      <div id="view-social" class="view">
        <div class="container-fluid">
          <div class="row row-cards">
            <div class="col-12">
              <div class="card">
                <div class="card-body d-flex flex-wrap align-items-center gap-2">
                  <div class="flex-fill">
                    <div class="d-flex align-items-center" id="social-connection" data-state="loading">
                      <span class="status-dot me-2 social-connection-dot"></span>
                      <b class="me-2">Sprawdzam połączenia</b>
                      <span class="text-secondary small" id="social-last-sync">Facebook i OpenAI</span>
                    </div>
                  </div>
                  <div class="btn-list">
                    <button class="btn btn-sm" id="social-refresh" type="button">Odśwież dane</button>
                    <button class="btn btn-primary btn-sm" id="social-analyze" type="button">Analizuj teraz</button>
                  </div>
                </div>
                <div class="card-body border-top">
                  <div class="datagrid">
                    <div class="datagrid-item"><div class="datagrid-title">Obserwujący</div><div class="datagrid-content" id="social-followers">—</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">Publikacje</div><div class="datagrid-content" id="social-post-count">—</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">Śr. interakcji</div><div class="datagrid-content" id="social-average">—</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">Zaangażowanie</div><div class="datagrid-content" id="social-engagement">—</div></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-lg-7">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Aktywność profilu</h3>
                  <div class="card-actions text-secondary small" id="social-feed-range">Ostatnie 12 postów</div>
                </div>
                <div class="list-group list-group-flush" id="social-posts">
                  <div class="list-group-item text-secondary">Sprawdzam połączenie z profilem klubowym…</div>
                </div>
              </div>
            </div>

            <div class="col-lg-5">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Co publikujemy dalej?</h3>
                  <div class="card-actions text-secondary small" id="social-analysis-model">OpenAI</div>
                </div>
                <div class="card-body" id="social-advice">
                  <p class="text-secondary mb-0">Po połączeniu usług wybierz „Analizuj teraz”.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== USTAWIENIA ==================== -->
      <div id="view-settings" class="view">
        <div class="container-fluid">
          <div class="row row-cards">
            <div class="col-lg-6">
              <div class="card">
                <div class="card-header">
                  <div>
                    <h3 class="card-title">Branding klubu</h3>
                    <div class="text-secondary small">Logo pojawia się na ekranie logowania i w panelu bocznym.</div>
                  </div>
                </div>
                <div class="card-body">
                  <div class="row align-items-center g-3">
                    <div class="col-auto">
                      <div class="border rounded d-flex align-items-center justify-content-center p-2"
                           id="brand-preview" style="width:150px;height:100px;overflow:hidden">
                        <% if (branding && branding.logoUrl) { %>
                          <img src="<%= branding.logoUrl %>" alt="Aktualne logo klubu" style="max-width:100%;max-height:100%;object-fit:contain">
                        <% } else { %>
                          <span class="text-secondary small">Brak logo</span>
                        <% } %>
                      </div>
                    </div>
                    <div class="col">
                      <div class="mb-2">PNG, JPG, WEBP lub SVG — najlepiej plik z przezroczystym tłem, maks. 5 MB.</div>
                      <div class="btn-list">
                        <label class="btn btn-primary mb-0">
                          <input id="brand-logo-input" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden>
                          Wybierz plik
                        </label>
                        <% if (branding && branding.logoUrl) { %>
                          <button class="btn" id="brand-logo-remove" type="button">Usuń logo</button>
                        <% } %>
                      </div>
                      <div class="small mt-2" id="branding-status"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-lg-6">
              <div class="card">
                <div class="card-header">
                  <div>
                    <h3 class="card-title">Magazyn zdjęć</h3>
                    <div class="text-secondary small">Storage zgodny z S3 — zdjęcia, assety i eksporty poza serwerem aplikacji.</div>
                  </div>
                </div>
                <div class="card-body">
                  <div class="mb-3"><label class="form-label">Endpoint</label><input class="form-control" placeholder="https://s3.eu-central-1.mega.io"></div>
                  <div class="mb-3"><label class="form-label">Bucket</label><input class="form-control" placeholder="zastal-media"></div>
                  <div class="mb-3"><label class="form-label">Domyślny prefix</label><input class="form-control" placeholder="2026-27/"></div>
                </div>
                <div class="card-footer text-end"><button class="btn btn-primary" type="button">Zapisz ustawienia</button></div>
              </div>
            </div>
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <div>
                    <h3 class="card-title">Integracje zewnętrzne</h3>
                    <div class="text-secondary small">Moduły, które wymagają kluczy dostępu wpisanych w pliku .env na serwerze.</div>
                  </div>
                </div>
                <div class="table-responsive">
                  <table class="table table-vcenter card-table">
                    <thead>
                      <tr><th>Integracja</th><th>Status</th><th>Wymagane w .env</th><th>Do czego służy</th></tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>Facebook (Meta Graph API)</td>
                        <td>
                          <% if (integrations.facebook.configured) { %>
                            <span class="badge bg-green-lt">Połączony</span>
                            <span class="text-secondary small ms-2">strona <%= integrations.facebook.pageId %></span>
                          <% } else { %>
                            <span class="badge bg-secondary-lt">Nieskonfigurowany</span>
                          <% } %>
                        </td>
                        <td class="text-secondary"><code>META_PAGE_ID</code>, <code>META_PAGE_ACCESS_TOKEN</code></td>
                        <td class="text-secondary">Monitoring publikacji i reakcji na profilu klubu. Bez tokenu pozycja „Monitoring social” jest ukryta w menu.</td>
                      </tr>
                      <tr>
                        <td>OpenAI</td>
                        <td>
                          <% if (integrations.openai.configured) { %>
                            <span class="badge bg-green-lt">Połączony</span>
                            <span class="text-secondary small ms-2"><%= integrations.openai.model %></span>
                          <% } else { %>
                            <span class="badge bg-secondary-lt">Nieskonfigurowany</span>
                          <% } %>
                        </td>
                        <td class="text-secondary"><code>OPENAI_API_KEY</code></td>
                        <td class="text-secondary">Rekomendacje treści na podstawie danych z Facebooka. Bez danych z FB nie ma czego analizować.</td>
                      </tr>
                      <tr>
                        <td>Magazyn zdjęć (S3 / MEGA)</td>
                        <td><span class="badge bg-secondary-lt">Nieskonfigurowany</span></td>
                        <td class="text-secondary">endpoint, bucket, klucze</td>
                        <td class="text-secondary">Zdjęcia, assety i eksporty poza serwerem aplikacji. Na razie eksporty zapisują się lokalnie.</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <div class="card-footer text-secondary small">
                  Po uzupełnieniu pliku <code>.env</code> wymagany jest restart procesu:
                  <code>pm2 restart zastal-marketing-center</code>. Kluczy nie trzymamy w repozytorium.
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script src="/vendor/tabler/js/tabler.min.js" defer></script>
<script src="/club/app.js?v=7" defer></script>
<script src="/club/branding.js?v=7" defer></script>
</body>
</html>
