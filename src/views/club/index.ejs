<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title><%= title %></title>
  <link rel="stylesheet" href="/club/styles.css">
  <link rel="stylesheet" href="/club/premium.css">
  <link rel="stylesheet" href="/club/operations.css">
</head>
<body class="app-body">
  <div class="app-shell" id="app-shell">
    <aside class="sidebar" id="sidebar">
      <div class="brand <%= branding?.logoUrl ? 'brand-logo-only' : '' %>">
        <% if (branding?.logoUrl) { %>
          <div class="brand-logo-frame sidebar-logo-wide"><img src="<%= branding.logoUrl %>" alt="Logo Zastal"></div>
        <% } else { %>
          <div class="crest">Z</div>
          <div><strong>ZASTAL</strong><span>MARKETING CENTER</span></div>
        <% } %>
      </div>
      <div class="season-wrap"><span>AKTYWNY SEZON</span><select class="season" aria-label="Sezon"><option>2026 / 27</option></select></div>
      <nav>
        <span class="nav-label">OPERACJE</span>
        <button data-view="dashboard"><i>01</i><span>Centrum dnia</span></button>
        <button class="active" data-view="matches"><i>02</i><span>Mecze</span></button>
        <button data-view="other"><i>03</i><span>Materiały klubowe</span></button>
        <span class="nav-label">ZASOBY</span>
        <button data-view="templates"><i>04</i><span>Szablony</span></button>
        <button data-view="library"><i>05</i><span>Biblioteka zdjęć</span></button>
        <button data-view="history"><i>06</i><span>Historia eksportów</span></button>
        <% if (user.role === 'admin') { %><button data-view="settings"><i>07</i><span>Ustawienia</span></button><% } %>
      </nav>
      <div class="storage"><div class="storage-head"><b>MAGAZYN MEDIÓW</b><em>MEGA S3</em></div><span>Oczekuje na konfigurację</span><div class="bar"><i style="width:0"></i></div><button type="button">Konfiguruj połączenie</button></div>
      <div class="profile">
        <div class="avatar"><%= user.displayName.split(' ').map(x=>x[0]).slice(0,2).join('').toUpperCase() %></div>
        <div class="profile-copy"><b><%= user.displayName %></b><span><%= user.role %></span></div>
        <form method="post" action="/logout"><button class="icon-btn" title="Wyloguj" aria-label="Wyloguj">↪</button></form>
      </div>
    </aside>

    <main class="workspace">
      <header class="topbar">
        <div class="topbar-left">
          <button class="mobile-menu" id="mobile-menu" type="button" aria-label="Menu">☰</button>
          <div><span class="eyebrow" id="eyebrow">MECZE</span><h1 id="page-title">Mecze</h1></div>
        </div>
        <div class="actions"><button class="ghost compact-hide">Podgląd</button><button class="primary" id="new-action">+ Nowy mecz</button></div>
      </header>

      <div class="view-stack">
        <section id="view-matches" class="view active-view">
          <div class="toolbar"><input placeholder="Szukaj meczu…"><select><option>Wszystkie statusy</option></select><select><option>Sezon 2026/27</option></select></div>
          <div class="match-list scroll-panel">
            <article class="match-row" data-match="zastal-anwil"><div class="team-logo green">Z</div><div class="match-main"><b>Zastal vs Anwil</b><span>Hala CRS, Zielona Góra</span></div><div class="score">92 : 81</div><div><b>27.09.2026</b><span>18:00</span></div><span class="pill live">Na żywo</span><div><b>4 / 8</b><span>grafiki</span></div><button>•••</button></article>
            <article class="match-row"><div class="team-logo">Ś</div><div class="match-main"><b>Śląsk vs Zastal</b><span>Hala Orbita, Wrocław</span></div><div class="score muted">- : -</div><div><b>04.10.2026</b><span>17:30</span></div><span class="pill planned">Zaplanowany</span><div><b>0 / 7</b><span>grafiki</span></div><button>•••</button></article>
            <article class="match-row"><div class="team-logo green">Z</div><div class="match-main"><b>Zastal vs King</b><span>Hala CRS, Zielona Góra</span></div><div class="score muted">- : -</div><div><b>11.10.2026</b><span>16:00</span></div><span class="pill planned">Zaplanowany</span><div><b>0 / 7</b><span>grafiki</span></div><button>•••</button></article>
          </div>
        </section>

        <section id="view-match" class="view">
          <div class="match-screen">
            <div class="match-header card">
              <div class="score-card"><div class="team-logo green">Z</div><div><strong>92 : 81</strong><span>FINAL</span></div><div class="team-logo blue">A</div><small>27.09.2026 • 18:00<br>Hala CRS, Zielona Góra</small></div>
              <div class="match-meta"><h3>Dane meczu</h3><dl><dt>Rozgrywki</dt><dd>ORLEN Basket Liga</dd><dt>Kolejka</dt><dd>3</dd><dt>Sędziowie</dt><dd>Kowalski, Nowak, Wiśniewski</dd></dl><button>Edytuj dane</button></div>
              <div class="folders"><h3>Foldery zdjęć</h3><button>📁 Photographer <span>312 zdjęć</span></button><button>📁 Social Media <span>89 zdjęć</span></button><button>📁 Selected <span>27 zdjęć</span></button><button class="ghost">Zarządzaj folderami</button></div>
            </div>
            <div class="section-title"><h2>Grafiki meczowe</h2><button class="primary">+ Dodaj grafikę</button></div>
            <div class="graphic-grid scroll-panel" id="graphic-grid"></div>
          </div>
        </section>

        <section id="view-editor" class="view editor-layout">
          <div class="editor-left card panel-scroll">
            <div class="tabs"><button class="active">EDYTOR</button><button>USTAWIENIA</button><button>HISTORIA</button></div>
            <h2 id="editor-template-name">Final Score</h2>
            <div id="dynamic-fields"></div>
          </div>
          <div class="canvas-wrap card">
            <div class="canvas-toolbar"><button>↶</button><button>↷</button><span id="canvas-size">1080 × 1350</span></div>
            <div class="canvas-stage"><canvas id="design-canvas" width="540" height="675"></canvas></div>
            <div class="zoom"><button>-</button><span>68%</span><button>+</button></div>
            <div class="exports"><h3>Ostatnie eksporty</h3><div class="export-strip"><div></div><div></div><div></div><div></div></div></div>
          </div>
          <div class="photos-panel card">
            <div class="panel-head"><div><h3>Zdjęcia z meczu</h3><span>MEGA S3 • foldery przypisane do meczu</span></div><button>↻</button></div>
            <div class="folder-tabs"><button class="active">Wszystkie</button><button>Photographer</button><button>Social</button><button>Selected</button></div>
            <input placeholder="Szukaj zdjęć…">
            <div class="photo-grid" id="photo-grid"></div>
            <button class="ghost full">Prześlij zdjęcia</button>
          </div>
        </section>

        <section id="view-templates" class="view">
          <div class="template-admin">
            <div class="card template-list panel-scroll"><div class="section-title"><h2>Szablony</h2><button class="primary" id="create-template">+ Nowy</button></div><div id="template-list"></div></div>
            <div class="card layer-editor panel-scroll"><div class="tabs"><button>PODGLĄD</button><button>POLA</button><button class="active">WARSTWY</button><button>USTAWIENIA</button></div><h3>Warstwy</h3><div id="layers-list"></div><button id="add-layer" class="ghost full">+ Dodaj warstwę</button></div>
            <div class="card layer-props panel-scroll"><h3>Właściwości warstwy</h3><div id="layer-properties"><p>Wybierz warstwę.</p></div></div>
          </div>
        </section>

        <section id="view-other" class="view"><div class="section-title"><h2>Inne grafiki</h2><button class="primary">+ Nowa grafika</button></div><div class="other-grid scroll-panel" id="other-grid"></div></section>
        <section id="view-library" class="view"><div class="section-title"><h2>Biblioteka zdjęć</h2><button class="primary">Prześlij zdjęcia</button></div><div class="big-photo-grid scroll-panel" id="library-grid"></div></section>
        <section id="view-history" class="view"><div class="card table-card"><h2>Historia eksportów</h2><div class="table-scroll"><table><thead><tr><th>Podgląd</th><th>Grafika</th><th>Mecz / typ</th><th>Data</th><th>Format</th><th>Użytkownik</th></tr></thead><tbody id="history-body"></tbody></table></div></div></section>
        <section id="view-dashboard" class="view operations-dashboard">
          <div class="ops-summary">
            <div><span>NAJBLIŻSZY MECZ</span><strong>04 PAŹ</strong><small>wyjazd · Wrocław</small></div>
            <div><span>DO PUBLIKACJI</span><strong>07</strong><small>materiałów w kolejce</small></div>
            <div><span>GOTOWOŚĆ</span><strong>68%</strong><small>pakietu meczowego</small></div>
            <div><span>ARCHIWUM</span><strong>4 286</strong><small>zdjęć w sezonie</small></div>
          </div>
          <div class="ops-grid">
            <article class="ops-primary">
              <header><div><span class="ops-overline">NASTĘPNE WYDARZENIE · KOLEJKA 4</span><h2>Śląsk Wrocław <i>vs</i> Zastal</h2></div><span class="ops-status">ZA 6 DNI</span></header>
              <div class="ops-match-meta"><div><span>DATA</span><b>04.10.2026 · 17:30</b></div><div><span>MIEJSCE</span><b>Hala Orbita, Wrocław</b></div><div><span>ROZGRYWKI</span><b>ORLEN Basket Liga</b></div></div>
              <div class="ops-progress-head"><span>PAKIET MECZOWY</span><b>5 z 7 materiałów</b></div>
              <div class="ops-progress"><i style="width:68%"></i></div>
              <div class="ops-checklist">
                <div class="done"><i>✓</i><span><b>Matchday</b><small>Eksport: 02.10 · 10:00</small></span><em>GOTOWE</em></div>
                <div class="done"><i>✓</i><span><b>Zapowiedź meczu</b><small>Wersje: feed + story</small></span><em>GOTOWE</em></div>
                <div><i>3</i><span><b>Starting Five</b><small>Oczekuje na skład</small></span><em>W TOKU</em></div>
                <div><i>4</i><span><b>Final Score</b><small>Szablon przypisany</small></span><em>PLAN</em></div>
              </div>
            </article>
            <aside class="ops-side">
              <section class="ops-activity"><header><div><span class="ops-overline">DZISIAJ</span><h3>Praca zespołu</h3></div><button>Pełna historia</button></header><div class="activity-row"><time>14:32</time><span><b>Final Score</b><small>wyeksportował Jan Kowalski</small></span><em>PNG</em></div><div class="activity-row"><time>13:48</time><span><b>87 nowych zdjęć</b><small>Zastal — Anwil / Photographer</small></span><em>S3</em></div><div class="activity-row"><time>12:10</time><span><b>Matchday zatwierdzony</b><small>przez Administratora</small></span><em>OK</em></div></section>
              <section class="ops-system"><header><span class="ops-overline">SYSTEMY</span><h3>Status usług</h3></header><div><span><i class="is-on"></i>Aplikacja</span><b>Sprawna</b></div><div><span><i></i>MEGA S3</span><b>Konfiguracja</b></div><div><span><i class="is-on"></i>Szablony</span><b>12 aktywnych</b></div></section>
            </aside>
          </div>
        </section>
        <section id="view-settings" class="view">
          <div class="settings-grid panel-scroll">
            <div class="card settings-card branding-card">
              <div class="settings-heading"><h2>Branding aplikacji</h2><p>Logo widoczne w panelu oraz na ekranie logowania.</p></div>
              <div class="brand-uploader">
                <div class="brand-preview" id="brand-preview">
                  <% if (branding?.logoUrl) { %><img src="<%= branding.logoUrl %>" alt="Aktualne logo"><% } else { %><span>Z</span><% } %>
                </div>
                <div class="brand-upload-copy">
                  <b>Logo klubu</b>
                  <span>PNG, JPG, WEBP lub SVG • najlepiej plik z przezroczystym tłem.</span>
                  <div class="brand-upload-actions">
                    <label class="primary upload-label"><input id="brand-logo-input" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden>Wybierz logo</label>
                    <% if (branding?.logoUrl) { %><button class="ghost" id="brand-logo-remove" type="button">Usuń</button><% } %>
                  </div>
                  <div class="settings-status" id="branding-status"></div>
                </div>
              </div>
            </div>
            <div class="card settings-card"><h2>MEGA S3</h2><label>Endpoint MEGA S3<input placeholder="https://s3...mega.io"></label><label>Bucket<input placeholder="club-media"></label><label>Domyślny prefix<input placeholder="2026-27/"></label><button class="primary">Zapisz ustawienia</button></div>
          </div>
        </section>
      </div>
    </main>
    <button class="sidebar-backdrop" id="sidebar-backdrop" type="button" aria-label="Zamknij menu"></button>
  </div>
  <script src="/club/app.js"></script>
  <script src="/club/branding.js"></script>
</body>
</html>
