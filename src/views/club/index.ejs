<!doctype html>
<html lang="pl" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="noindex,nofollow">
  <title><%= title %></title>
  <link rel="icon" href="<%= (branding && branding.logoUrl) ? branding.logoUrl : 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22%3E%3Crect width=%2232%22 height=%2232%22 fill=%22%230b0d0d%22/%3E%3Ccircle cx=%2216%22 cy=%2216%22 r=%229%22 fill=%22none%22 stroke=%22%230d8f4f%22 stroke-width=%222%22/%3E%3Cpath d=%22M7 16h18M16 7c-3 4-3 14 0 18M16 7c3 4 3 14 0 18%22 fill=%22none%22 stroke=%22%230d8f4f%22 stroke-width=%221.4%22/%3E%3C/svg%3E' %>">
  <link rel="stylesheet" href="/vendor/tabler/css/tabler.min.css">
  <link rel="stylesheet" href="/club/brand.css?v=7">
</head>
<%
  const role = user.role || 'social';
  const can = (...roles) => roles.includes(role);
  const initials = String(user.displayName || user.email)
    .split(' ').map(part => part[0]).slice(0, 2).join('').toUpperCase();
  const roleLabels = { admin: 'Administrator', designer: 'Grafik', social: 'Social media', photographer: 'Fotograf' };
  const d = dashboard;
  const m = d.nextMatch;
  const clubName = (branding && branding.clubName) || 'Zastal';
  const progress = d.counters.materialsTotal
    ? Math.round(d.counters.materialsReady / d.counters.materialsTotal * 100)
    : 0;
  // Układ nawigacji: pasek górny (wariant wybrany przez właściciela projektu).
  const partials = { branding, user, role, can, initials, roleLabels, d, integrations };
%>
<body class="app-body" data-role="<%= role %>" data-club="<%= clubName %>">
<%- include('_icons') %>

<div class="page">
  <!-- ======================= NAWIGACJA ======================= -->
  <header class="navbar navbar-expand-md d-print-none" data-bs-theme="dark">
    <div class="container-fluid">
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topbar-menu"
              aria-controls="topbar-menu" aria-expanded="false" aria-label="Menu">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="navbar-brand navbar-brand-club me-3 me-lg-4"><%- include('_brand', partials) %></div>

      <div class="navbar-nav flex-row order-md-last ms-auto align-items-center">
        <div class="nav-item status-magazyn d-none d-md-flex me-3">
          <span class="status status-warning status-lite" title="Magazyn zdjęć nieskonfigurowany">
            <span class="status-dot"></span>Magazyn
          </span>
        </div>
        <div class="d-flex align-items-center"><%- include('_user', partials) %></div>
      </div>

      <div class="collapse navbar-collapse" id="topbar-menu">
        <ul class="navbar-nav"><%- include('_nav-items', partials) %></ul>
      </div>
    </div>
  </header>

  <!-- ======================= OBSZAR ROBOCZY ======================= -->
  <div class="page-wrapper">
    <div class="page-header d-print-none">
      <div class="container-fluid">
        <div class="row g-2 align-items-center">
          <div class="col">
            <div class="page-pretitle" id="eyebrow"><%= d.season ? 'Sezon ' + d.season.name : 'Brak sezonu' %></div>
            <h2 class="page-title" id="page-title">Dashboard</h2>
          </div>
          <div class="col-auto ms-auto">
            <div class="btn-list align-items-center">
              <% if (d.seasons.length) { %>
                <select class="form-select form-select-sm w-auto" id="season-switch" aria-label="Aktywny sezon"
                        <%= role === 'admin' ? '' : 'disabled' %>>
                  <% d.seasons.forEach(season => { %>
                    <option value="<%= season.id %>" <%= d.season && season.id === d.season.id ? 'selected' : '' %>>
                      <%= season.name %>
                    </option>
                  <% }) %>
                </select>
              <% } %>
              <% if (role === 'admin') { %>
                <button class="btn btn-primary" id="new-action" type="button"
                        data-match-new data-bs-toggle="modal" data-bs-target="#match-modal">
                  <svg class="icon"><use href="#i-plus"></use></svg>Nowy mecz
                </button>
              <% } else if (role === 'photographer') { %>
                <button class="btn btn-primary" id="new-action" type="button">
                  <svg class="icon"><use href="#i-upload"></use></svg>Prześlij zdjęcia
                </button>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="page-body">

      <!-- ==================== DASHBOARD ==================== -->
      <div id="view-dashboard" class="view active-view">
        <div class="container-fluid">

          <% if (!d.season) { %>
            <div class="empty">
              <div class="empty-icon"><svg class="icon icon-lg"><use href="#i-calendar"></use></svg></div>
              <p class="empty-title">Brak sezonu</p>
              <p class="empty-subtitle text-secondary">
                Aplikacja układa pracę wokół sezonu i meczów. Zacznij od utworzenia sezonu,
                potem dodasz do niego mecze.
              </p>
              <% if (role === 'admin') { %>
                <div class="empty-action">
                  <button class="btn btn-primary" type="button" data-season-new data-bs-toggle="modal" data-bs-target="#season-modal">
                    <svg class="icon"><use href="#i-plus"></use></svg>Utwórz sezon
                  </button>
                </div>
              <% } else { %>
                <p class="empty-subtitle text-secondary">Poproś administratora o utworzenie sezonu.</p>
              <% } %>
            </div>

          <% } else if (!m) { %>
            <div class="empty">
              <div class="empty-icon"><svg class="icon icon-lg"><use href="#i-match"></use></svg></div>
              <p class="empty-title">Sezon <%= d.season.name %> nie ma jeszcze meczów</p>
              <p class="empty-subtitle text-secondary">Dodaj pierwszy mecz, żeby zobaczyć harmonogram materiałów.</p>
              <% if (role === 'admin') { %>
                <div class="empty-action">
                  <button class="btn btn-primary" type="button" data-match-new data-bs-toggle="modal" data-bs-target="#match-modal">
                    <svg class="icon"><use href="#i-plus"></use></svg>Dodaj mecz
                  </button>
                </div>
              <% } %>
            </div>

          <% } else { %>
            <div class="row row-cards">

              <!-- Najbliższy mecz -->
              <div class="col-12">
                <div class="card">
                  <div class="card-header">
                    <h3 class="card-title">
                      <%= m.status === 'finished' ? 'Ostatni mecz' : 'Najbliższy mecz' %>
                    </h3>
                    <div class="card-actions btn-actions">
                      <% if (m.competition || m.round_name) { %>
                        <span class="badge bg-secondary-lt me-2">
                          <%= [m.competition, m.round_name].filter(Boolean).join(' · ') %>
                        </span>
                      <% } %>
                      <span class="badge <%= fmt.matchStatus(m.status).badge %> me-2"><%= fmt.matchStatus(m.status).label %></span>
                      <button class="btn btn-primary btn-sm" type="button" data-view="matches">Otwórz mecz</button>
                    </div>
                  </div>
                  <div class="card-body">
                    <div class="fixture-title mb-3">
                      <span class="<%= fmt.isClub(m.home_team, clubName) ? 'club' : '' %>"><%= m.home_team %></span>
                      <span class="text-secondary mx-2">—</span>
                      <span class="<%= fmt.isClub(m.away_team, clubName) ? 'club' : '' %>"><%= m.away_team %></span>
                      <% if (fmt.score(m)) { %>
                        <span class="ms-3"><%= fmt.score(m) %></span>
                      <% } %>
                    </div>
                    <div class="datagrid">
                      <div class="datagrid-item">
                        <div class="datagrid-title">Termin</div>
                        <div class="datagrid-content"><%= fmt.dateTime(m.match_date) %></div>
                      </div>
                      <div class="datagrid-item">
                        <div class="datagrid-title">Hala</div>
                        <div class="datagrid-content"><%= m.venue || '—' %></div>
                      </div>
                      <div class="datagrid-item">
                        <div class="datagrid-title">Do meczu</div>
                        <div class="datagrid-content"><%= fmt.relativeDays(m.match_date) || '—' %></div>
                      </div>
                      <div class="datagrid-item d-none d-sm-block">
                        <div class="datagrid-title">Materiały gotowe</div>
                        <div class="datagrid-content"><%= d.counters.materialsReady %> / <%= d.counters.materialsTotal %></div>
                      </div>
                      <div class="datagrid-item d-none d-sm-block">
                        <div class="datagrid-title">Zdjęcia w folderach</div>
                        <div class="datagrid-content"><%= d.counters.photoCount %></div>
                      </div>
                      <div class="datagrid-item d-none d-sm-block">
                        <div class="datagrid-title">Eksporty (7 dni)</div>
                        <div class="datagrid-content"><%= d.counters.weekExports %></div>
                      </div>
                    </div>
                  </div>
                  <% if (d.counters.materialsTotal) { %>
                    <div class="card-footer">
                      <div class="row align-items-center g-2">
                        <div class="col-auto text-secondary small">Pakiet materiałów meczowych</div>
                        <div class="col">
                          <div class="progress progress-sm">
                            <div class="progress-bar bg-green" style="width: <%= progress %>%" role="progressbar"
                                 aria-valuenow="<%= progress %>" aria-valuemin="0" aria-valuemax="100">
                              <span class="visually-hidden"><%= progress %>% gotowych</span>
                            </div>
                          </div>
                        </div>
                        <div class="col-auto text-secondary small"><%= d.counters.materialsReady %> / <%= d.counters.materialsTotal %> gotowych</div>
                      </div>
                    </div>
                  <% } %>
                </div>
              </div>

              <!-- Harmonogram materiałów -->
              <div class="col-lg-8">
                <div class="card">
                  <div class="card-header">
                    <h3 class="card-title">Materiały na ten mecz</h3>
                    <div class="card-actions text-secondary small"><%= d.materials.length %></div>
                  </div>
                  <% if (!d.materials.length) { %>
                    <div class="card-body text-secondary">
                      Do tego meczu nie przypisano jeszcze żadnych szablonów.
                      Pakiet grafik przypisuje się w bibliotece szablonów.
                    </div>
                  <% } else { %>
                    <div class="table-responsive">
                      <table class="table table-vcenter card-table">
                        <thead>
                          <tr><th>Materiał</th><th>Format</th><th>Termin</th><th>Odpowiedzialny</th><th class="w-1">Status</th></tr>
                        </thead>
                        <tbody>
                          <% d.materials.forEach(item => { %>
                            <tr>
                              <td>
                                <div><%= item.template_name %></div>
                                <% if (item.note) { %><div class="text-secondary small"><%= item.note %></div><% } %>
                              </td>
                              <td class="text-secondary text-nowrap"><%= item.width %>×<%= item.height %></td>
                              <td class="text-secondary text-nowrap">
                                <%= item.deadline_at ? fmt.dateTime(item.deadline_at) : '—' %>
                              </td>
                              <td class="text-secondary"><%= item.owner_role ? fmt.roleLabel(item.owner_role) : '—' %></td>
                              <td>
                                <span class="badge <%= fmt.materialStatus(item.status).badge %>">
                                  <%= fmt.materialStatus(item.status).label %>
                                </span>
                              </td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                  <% } %>
                </div>
              </div>

              <!-- Kolumna kontrolna -->
              <div class="col-lg-4">
                <div class="row row-cards">
                  <div class="col-12">
                    <div class="card">
                      <div class="card-header">
                        <h3 class="card-title">Wymaga decyzji</h3>
                        <div class="card-actions">
                          <span class="badge <%= d.alerts.length ? 'bg-red-lt' : 'bg-green-lt' %>"><%= d.alerts.length %></span>
                        </div>
                      </div>
                      <% if (!d.alerts.length) { %>
                        <div class="card-body text-secondary">Nic nie wymaga reakcji.</div>
                      <% } else { %>
                        <div class="list-group list-group-flush">
                          <% d.alerts.forEach(item => { %>
                            <div class="list-group-item">
                              <div class="row align-items-center g-2">
                                <div class="col-auto">
                                  <span class="status-dot <%= item.level === 'urgent' ? 'status-dot-animated bg-red' : 'bg-yellow' %>"></span>
                                </div>
                                <div class="col">
                                  <div><%= item.title %></div>
                                  <div class="text-secondary small"><%= item.detail %></div>
                                </div>
                              </div>
                            </div>
                          <% }) %>
                        </div>
                      <% } %>
                    </div>
                  </div>

                  <div class="col-12">
                    <div class="card">
                      <div class="card-header">
                        <h3 class="card-title">Foldery zdjęć meczu</h3>
                        <div class="card-actions"><a href="#" class="btn btn-link btn-sm" data-view="library">Biblioteka</a></div>
                      </div>
                      <% if (!d.folders.length) { %>
                        <div class="card-body text-secondary">Do tego meczu nie przypisano folderów zdjęć.</div>
                      <% } else { %>
                        <div class="list-group list-group-flush">
                          <% d.folders.forEach(folder => { %>
                            <div class="list-group-item d-flex align-items-center">
                              <svg class="icon me-2 text-secondary"><use href="#i-folder"></use></svg>
                              <span class="flex-fill text-truncate"><%= folder.name %></span>
                              <span class="badge bg-secondary-lt"><%= folder.photo_count %></span>
                            </div>
                          <% }) %>
                        </div>
                      <% } %>
                    </div>
                  </div>

                  <div class="col-12">
                    <div class="card">
                      <div class="card-header">
                        <h3 class="card-title">Ostatnie eksporty</h3>
                        <div class="card-actions"><a href="#" class="btn btn-link btn-sm" data-view="history">Historia</a></div>
                      </div>
                      <% if (!d.exports.length) { %>
                        <div class="card-body text-secondary">Nie wyeksportowano jeszcze żadnej grafiki.</div>
                      <% } else { %>
                        <div class="list-group list-group-flush">
                          <% d.exports.forEach(item => { %>
                            <div class="list-group-item d-flex align-items-center">
                              <div class="flex-fill text-truncate">
                                <div class="text-truncate"><%= item.design_title || item.template_name %></div>
                                <div class="text-secondary small text-truncate">
                                  <%= item.format.toUpperCase() %> <%= item.width %>×<%= item.height %>
                                </div>
                              </div>
                              <span class="text-secondary small ms-2"><%= fmt.date(item.created_at) %></span>
                            </div>
                          <% }) %>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          <% } %>
        </div>
      </div>

      <!-- ==================== MECZE ==================== -->
      <div id="view-matches" class="view">
        <div class="container-fluid">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">
                Mecze<% if (d.season) { %> — sezon <%= d.season.name %><% } %>
              </h3>
              <div class="card-actions d-flex gap-2">
                <div class="input-group input-group-flat w-auto">
                  <span class="input-group-text"><svg class="icon"><use href="#i-search"></use></svg></span>
                  <input type="search" class="form-control" id="match-search" placeholder="Szukaj drużyny lub hali…" aria-label="Szukaj meczu">
                </div>
                <select class="form-select w-auto" id="match-status-filter" aria-label="Status">
                  <option value="">Wszystkie statusy</option>
                  <option value="planned">Zaplanowane</option>
                  <option value="live">Na żywo</option>
                  <option value="finished">Rozegrane</option>
                  <option value="cancelled">Odwołane</option>
                </select>
                <% if (role === 'admin') { %>
                  <button class="btn btn-primary" type="button" data-match-new data-bs-toggle="modal" data-bs-target="#match-modal">
                    <svg class="icon"><use href="#i-plus"></use></svg>Dodaj mecz
                  </button>
                <% } %>
              </div>
            </div>

            <div class="table-responsive">
              <table class="table table-vcenter card-table table-hover">
                <thead>
                  <tr>
                    <th>Mecz</th><th>Termin</th><th>Wynik</th><th>Status</th><th>Materiały</th>
                    <% if (role === 'admin') { %><th class="w-1"></th><% } %>
                  </tr>
                </thead>
                <tbody id="matches-body"></tbody>
              </table>
            </div>
            <div class="card-body text-secondary d-none" id="matches-empty"></div>
          </div>
        </div>
      </div>

      <!-- ==================== CENTRUM MECZU ==================== -->
      <div id="view-match" class="view">
        <div class="container-fluid">
          <div class="row row-cards">
            <div class="col-lg-4">
              <div class="card">
                <div class="card-body text-center">
                  <div class="text-secondary text-uppercase small">Wynik końcowy</div>
                  <div class="display-6 fw-bold my-2">92 : 81</div>
                  <div>Zastal — Anwil Włocławek</div>
                  <div class="text-secondary small mt-2">27.09.2026 · 18:00<br>Hala CRS, Zielona Góra</div>
                </div>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="card">
                <div class="card-header"><h3 class="card-title">Dane meczu</h3></div>
                <div class="card-body">
                  <div class="datagrid">
                    <div class="datagrid-item"><div class="datagrid-title">Rozgrywki</div><div class="datagrid-content">ORLEN Basket Liga</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">Kolejka</div><div class="datagrid-content">3</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">Sezon</div><div class="datagrid-content"><%= d.season ? d.season.name : '—' %></div></div>
                  </div>
                </div>
                <div class="card-footer"><button class="btn btn-sm w-100" type="button">Edytuj dane meczu</button></div>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="card">
                <div class="card-header"><h3 class="card-title">Foldery zdjęć</h3></div>
                <% if (!d.folders.length) { %>
                  <div class="card-body text-secondary">Brak folderów przypisanych do tego meczu.</div>
                <% } else { %>
                  <div class="list-group list-group-flush">
                    <% d.folders.forEach(folder => { %>
                      <a href="#" class="list-group-item list-group-item-action d-flex align-items-center">
                        <svg class="icon me-2 text-secondary"><use href="#i-folder"></use></svg>
                        <span class="flex-fill"><%= folder.name %></span>
                        <span class="badge bg-secondary-lt"><%= folder.photo_count %></span>
                      </a>
                    <% }) %>
                  </div>
                <% } %>
                <div class="card-footer"><button class="btn btn-sm w-100" type="button">Zarządzaj folderami</button></div>
              </div>
            </div>

            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Grafiki meczowe</h3>
                  <div class="card-actions">
                    <button class="btn btn-primary btn-sm" type="button"><svg class="icon"><use href="#i-plus"></use></svg>Dodaj grafikę</button>
                  </div>
                </div>
                <div class="card-body">
                  <div class="row row-cards" id="graphic-grid"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== EDYTOR ==================== -->
      <div id="view-editor" class="view">
        <div class="container-fluid">
          <div class="row row-cards">
            <div class="col-lg-3">
              <div class="card">
                <div class="card-header">
                  <ul class="nav nav-tabs card-header-tabs" role="tablist">
                    <li class="nav-item"><a href="#" class="nav-link active">Edytor</a></li>
                    <li class="nav-item"><a href="#" class="nav-link">Ustawienia</a></li>
                    <li class="nav-item"><a href="#" class="nav-link">Historia</a></li>
                  </ul>
                </div>
                <div class="card-body">
                  <h4 id="editor-template-name" class="mb-3">Final Score</h4>
                  <div id="dynamic-fields"></div>
                </div>
              </div>
            </div>

            <div class="col-lg-6">
              <div class="card">
                <div class="card-header">
                  <div class="btn-list">
                    <button class="btn btn-icon btn-sm" type="button" aria-label="Cofnij"><svg class="icon"><use href="#i-undo"></use></svg></button>
                    <button class="btn btn-icon btn-sm" type="button" aria-label="Ponów"><svg class="icon"><use href="#i-redo"></use></svg></button>
                  </div>
                  <div class="card-actions text-secondary small" id="canvas-size">1080 × 1350</div>
                </div>
                <div class="card-body">
                  <div class="canvas-stage bg-dark rounded p-2" style="height:min(60vh,640px)">
                    <canvas id="design-canvas" width="540" height="675"></canvas>
                  </div>
                </div>
                <div class="card-footer">
                  <div class="row align-items-center">
                    <div class="col text-secondary small">Podgląd 68% — eksport zawsze w rozdzielczości szablonu</div>
                    <div class="col-auto"><button class="btn btn-primary btn-sm" type="button">Eksportuj PNG</button></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-lg-3">
              <div class="card">
                <div class="card-header">
                  <div>
                    <h3 class="card-title">Zdjęcia z meczu</h3>
                    <div class="text-secondary small">Foldery przypisane do spotkania</div>
                  </div>
                  <div class="card-actions">
                    <button class="btn btn-icon btn-sm" type="button" aria-label="Odśwież"><svg class="icon"><use href="#i-refresh"></use></svg></button>
                  </div>
                </div>
                <div class="card-body">
                  <div class="btn-group w-100 mb-3" role="group">
                    <input type="radio" class="btn-check" name="photo-folder" id="pf-all" checked>
                    <label for="pf-all" class="btn btn-sm">Wszystkie</label>
                    <input type="radio" class="btn-check" name="photo-folder" id="pf-photo">
                    <label for="pf-photo" class="btn btn-sm">Photo</label>
                    <input type="radio" class="btn-check" name="photo-folder" id="pf-sel">
                    <label for="pf-sel" class="btn btn-sm">Wybrane</label>
                  </div>
                  <div class="row g-2 scroll-y" id="photo-grid" style="max-height:min(48vh,460px)"></div>
                </div>
                <div class="card-footer">
                  <button class="btn btn-sm w-100" type="button"><svg class="icon"><use href="#i-upload"></use></svg>Prześlij zdjęcia</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== SZABLONY ==================== -->
      <div id="view-templates" class="view">
        <div class="container-fluid">
          <div class="row row-cards">
            <div class="col-lg-4">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Szablony</h3>
                  <div class="card-actions">
                    <button class="btn btn-primary btn-sm" id="create-template" type="button"><svg class="icon"><use href="#i-plus"></use></svg>Nowy</button>
                  </div>
                </div>
                <div class="list-group list-group-flush" id="template-list"></div>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="card">
                <div class="card-header"><h3 class="card-title">Warstwy</h3></div>
                <div class="list-group list-group-flush" id="layers-list"></div>
                <div class="card-footer">
                  <button id="add-layer" class="btn btn-sm w-100" type="button"><svg class="icon"><use href="#i-plus"></use></svg>Dodaj warstwę</button>
                </div>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="card">
                <div class="card-header"><h3 class="card-title">Właściwości warstwy</h3></div>
                <div class="card-body" id="layer-properties"><p class="text-secondary">Wybierz warstwę z listy.</p></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== INNE GRAFIKI ==================== -->
      <div id="view-other" class="view">
        <div class="container-fluid">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Inne grafiki</h3>
              <div class="card-actions">
                <button class="btn btn-primary btn-sm" type="button"><svg class="icon"><use href="#i-plus"></use></svg>Nowa grafika</button>
              </div>
            </div>
            <div class="card-body">
              <div class="row row-cards" id="other-grid"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== BIBLIOTEKA ZDJĘĆ ==================== -->
      <div id="view-library" class="view">
        <div class="container-fluid">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Biblioteka zdjęć</h3>
              <div class="card-actions">
                <button class="btn btn-primary btn-sm" type="button"><svg class="icon"><use href="#i-upload"></use></svg>Prześlij zdjęcia</button>
              </div>
            </div>
            <div class="card-body">
              <div class="row g-2" id="library-grid"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== HISTORIA ==================== -->
      <div id="view-history" class="view">
        <div class="container-fluid">
          <div class="card">
            <div class="card-header"><h3 class="card-title">Historia eksportów</h3></div>
            <div class="table-responsive">
              <table class="table table-vcenter card-table">
                <thead><tr><th class="w-1">Podgląd</th><th>Grafika</th><th>Mecz / typ</th><th>Data</th><th>Format</th><th>Użytkownik</th></tr></thead>
                <tbody id="history-body"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== MONITORING SOCIAL ==================== -->
      <div id="view-social" class="view">
        <div class="container-fluid">
          <div class="row row-cards">
            <div class="col-12">
              <div class="card">
                <div class="card-body d-flex flex-wrap align-items-center gap-2">
                  <div class="flex-fill">
                    <div class="d-flex align-items-center" id="social-connection" data-state="loading">
                      <span class="status-dot me-2 social-connection-dot"></span>
                      <b class="me-2">Sprawdzam połączenia</b>
                      <span class="text-secondary small" id="social-last-sync">Facebook i OpenAI</span>
                    </div>
                  </div>
                  <div class="btn-list">
                    <button class="btn btn-sm" id="social-refresh" type="button">Odśwież dane</button>
                    <button class="btn btn-primary btn-sm" id="social-analyze" type="button">Analizuj teraz</button>
                  </div>
                </div>
                <div class="card-body border-top">
                  <div class="datagrid">
                    <div class="datagrid-item"><div class="datagrid-title">Obserwujący</div><div class="datagrid-content" id="social-followers">—</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">Publikacje</div><div class="datagrid-content" id="social-post-count">—</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">Śr. interakcji</div><div class="datagrid-content" id="social-average">—</div></div>
                    <div class="datagrid-item"><div class="datagrid-title">Zaangażowanie</div><div class="datagrid-content" id="social-engagement">—</div></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-lg-7">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Aktywność profilu</h3>
                  <div class="card-actions text-secondary small" id="social-feed-range">Ostatnie 12 postów</div>
                </div>
                <div class="list-group list-group-flush" id="social-posts">
                  <div class="list-group-item text-secondary">Sprawdzam połączenie z profilem klubowym…</div>
                </div>
              </div>
            </div>

            <div class="col-lg-5">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Co publikujemy dalej?</h3>
                  <div class="card-actions text-secondary small" id="social-analysis-model">OpenAI</div>
                </div>
                <div class="card-body" id="social-advice">
                  <p class="text-secondary mb-0">Po połączeniu usług wybierz „Analizuj teraz”.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== USTAWIENIA ==================== -->
      <div id="view-settings" class="view">
        <div class="container-fluid">
          <div class="row row-cards">
            <div class="col-lg-6">
              <div class="card">
                <div class="card-header">
                  <div>
                    <h3 class="card-title">Branding klubu</h3>
                    <div class="text-secondary small">Logo pojawia się na ekranie logowania i w panelu bocznym.</div>
                  </div>
                </div>
                <div class="card-body">
                  <div class="row align-items-center g-3">
                    <div class="col-auto">
                      <div class="border rounded d-flex align-items-center justify-content-center p-2"
                           id="brand-preview" style="width:150px;height:100px;overflow:hidden">
                        <% if (branding && branding.logoUrl) { %>
                          <img src="<%= branding.logoUrl %>" alt="Aktualne logo klubu" style="max-width:100%;max-height:100%;object-fit:contain">
                        <% } else { %>
                          <span class="text-secondary small">Brak logo</span>
                        <% } %>
                      </div>
                    </div>
                    <div class="col">
                      <div class="mb-2">PNG, JPG, WEBP lub SVG — najlepiej plik z przezroczystym tłem, maks. 5 MB.</div>
                      <div class="btn-list">
                        <label class="btn btn-primary mb-0">
                          <input id="brand-logo-input" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden>
                          Wybierz plik
                        </label>
                        <% if (branding && branding.logoUrl) { %>
                          <button class="btn" id="brand-logo-remove" type="button">Usuń logo</button>
                        <% } %>
                      </div>
                      <div class="small mt-2" id="branding-status"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-lg-6">
              <div class="card">
                <div class="card-header">
                  <div>
                    <h3 class="card-title">Magazyn zdjęć</h3>
                    <div class="text-secondary small">Storage zgodny z S3 — zdjęcia, assety i eksporty poza serwerem aplikacji.</div>
                  </div>
                </div>
                <div class="card-body">
                  <div class="mb-3"><label class="form-label">Endpoint</label><input class="form-control" placeholder="https://s3.eu-central-1.mega.io"></div>
                  <div class="mb-3"><label class="form-label">Bucket</label><input class="form-control" placeholder="zastal-media"></div>
                  <div class="mb-3"><label class="form-label">Domyślny prefix</label><input class="form-control" placeholder="2026-27/"></div>
                </div>
                <div class="card-footer text-end"><button class="btn btn-primary" type="button">Zapisz ustawienia</button></div>
              </div>
            </div>
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <div>
                    <h3 class="card-title">Sezony</h3>
                    <div class="text-secondary small">Aktywny sezon decyduje, które mecze widać w aplikacji.</div>
                  </div>
                  <div class="card-actions">
                    <button class="btn btn-primary btn-sm" type="button" data-season-new data-bs-toggle="modal" data-bs-target="#season-modal">
                      <svg class="icon"><use href="#i-plus"></use></svg>Nowy sezon
                    </button>
                  </div>
                </div>
                <div class="table-responsive">
                  <table class="table table-vcenter card-table">
                    <thead>
                      <tr><th>Sezon</th><th>Okres</th><th>Mecze</th><th>Status</th><th class="w-1"></th></tr>
                    </thead>
                    <tbody id="seasons-body"></tbody>
                  </table>
                </div>
              </div>
            </div>

            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <div>
                    <h3 class="card-title">Integracje zewnętrzne</h3>
                    <div class="text-secondary small">Moduły, które wymagają kluczy dostępu wpisanych w pliku .env na serwerze.</div>
                  </div>
                </div>
                <div class="table-responsive">
                  <table class="table table-vcenter card-table">
                    <thead>
                      <tr><th>Integracja</th><th>Status</th><th>Wymagane w .env</th><th>Do czego służy</th></tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>Facebook (Meta Graph API)</td>
                        <td>
                          <% if (integrations.facebook.configured) { %>
                            <span class="badge bg-green-lt">Połączony</span>
                            <span class="text-secondary small ms-2">strona <%= integrations.facebook.pageId %></span>
                          <% } else { %>
                            <span class="badge bg-secondary-lt">Nieskonfigurowany</span>
                          <% } %>
                        </td>
                        <td class="text-secondary"><code>META_PAGE_ID</code>, <code>META_PAGE_ACCESS_TOKEN</code></td>
                        <td class="text-secondary">Monitoring publikacji i reakcji na profilu klubu. Bez tokenu pozycja „Monitoring social” jest ukryta w menu.</td>
                      </tr>
                      <tr>
                        <td>OpenAI</td>
                        <td>
                          <% if (integrations.openai.configured) { %>
                            <span class="badge bg-green-lt">Połączony</span>
                            <span class="text-secondary small ms-2"><%= integrations.openai.model %></span>
                          <% } else { %>
                            <span class="badge bg-secondary-lt">Nieskonfigurowany</span>
                          <% } %>
                        </td>
                        <td class="text-secondary"><code>OPENAI_API_KEY</code></td>
                        <td class="text-secondary">Rekomendacje treści na podstawie danych z Facebooka. Bez danych z FB nie ma czego analizować.</td>
                      </tr>
                      <tr>
                        <td>Magazyn zdjęć (S3 / MEGA)</td>
                        <td><span class="badge bg-secondary-lt">Nieskonfigurowany</span></td>
                        <td class="text-secondary">endpoint, bucket, klucze</td>
                        <td class="text-secondary">Zdjęcia, assety i eksporty poza serwerem aplikacji. Na razie eksporty zapisują się lokalnie.</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <div class="card-footer text-secondary small">
                  Po uzupełnieniu pliku <code>.env</code> wymagany jest restart procesu:
                  <code>pm2 restart zastal-marketing-center</code>. Kluczy nie trzymamy w repozytorium.
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</div>


<!-- ==================== MODALE ==================== -->
<div class="modal modal-blur fade" id="match-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="match-modal-title">Nowy mecz</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
      </div>
      <form id="match-form" novalidate>
        <div class="modal-body">
          <div class="alert alert-danger d-none" id="match-form-error" role="alert"></div>
          <input type="hidden" name="id">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label required" for="match-home">Gospodarz</label>
              <input class="form-control" id="match-home" name="home_team" maxlength="160" required>
            </div>
            <div class="col-md-6">
              <label class="form-label required" for="match-away">Gość</label>
              <input class="form-control" id="match-away" name="away_team" maxlength="160" required>
            </div>
            <div class="col-md-6">
              <label class="form-label required" for="match-date">Data i godzina</label>
              <input class="form-control" id="match-date" name="match_date" type="datetime-local" required>
            </div>
            <div class="col-md-6">
              <label class="form-label required" for="match-season">Sezon</label>
              <select class="form-select" id="match-season" name="season_id" required>
                <% d.seasons.forEach(season => { %>
                  <option value="<%= season.id %>" <%= d.season && season.id === d.season.id ? 'selected' : '' %>>
                    <%= season.name %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="match-competition">Rozgrywki</label>
              <input class="form-control" id="match-competition" name="competition" maxlength="160" placeholder="ORLEN Basket Liga">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="match-round">Kolejka</label>
              <input class="form-control" id="match-round" name="round_name" maxlength="80" placeholder="Kolejka 4">
            </div>
            <div class="col-12">
              <label class="form-label" for="match-venue">Hala</label>
              <input class="form-control" id="match-venue" name="venue" maxlength="255" placeholder="Hala CRS, Zielona Góra">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="match-status">Status</label>
              <select class="form-select" id="match-status" name="status">
                <option value="planned">Zaplanowany</option>
                <option value="live">Na żywo</option>
                <option value="finished">Rozegrany</option>
                <option value="cancelled">Odwołany</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="match-home-score">Wynik gospodarza</label>
              <input class="form-control" id="match-home-score" name="home_score" type="number" min="0" max="300" placeholder="—">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="match-away-score">Wynik gościa</label>
              <input class="form-control" id="match-away-score" name="away_score" type="number" min="0" max="300" placeholder="—">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Anuluj</button>
          <button type="submit" class="btn btn-primary ms-auto" id="match-submit">Zapisz mecz</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal modal-blur fade" id="season-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="season-modal-title">Nowy sezon</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
      </div>
      <form id="season-form" novalidate>
        <div class="modal-body">
          <div class="alert alert-danger d-none" id="season-form-error" role="alert"></div>
          <input type="hidden" name="id">
          <div class="mb-3">
            <label class="form-label required" for="season-name">Nazwa sezonu</label>
            <input class="form-control" id="season-name" name="name" maxlength="64" placeholder="2026 / 27" required>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="season-start">Początek</label>
              <input class="form-control" id="season-start" name="starts_on" type="date">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="season-end">Koniec</label>
              <input class="form-control" id="season-end" name="ends_on" type="date">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Anuluj</button>
          <button type="submit" class="btn btn-primary ms-auto">Zapisz sezon</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/vendor/tabler/js/tabler.min.js" defer></script>
<script src="/club/app.js?v=7" defer></script>
<script src="/club/branding.js?v=7" defer></script>
</body>
</html>
