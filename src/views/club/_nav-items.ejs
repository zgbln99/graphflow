<%# Pozycje menu w pasku górnym, filtrowane rolą użytkownika.
    Sekcja biblioteczna jest zwinięta do jednego rozwijanego menu, żeby pasek
    mieścił się w jednym rzędzie także na 1280 px. %>
<li class="nav-item active">
  <a class="nav-link" href="#" data-view="dashboard">
    <span class="nav-link-icon"><svg class="icon"><use href="#i-dashboard"></use></svg></span>
    <span class="nav-link-title">Dashboard</span>
  </a>
</li>
<li class="nav-item">
  <a class="nav-link" href="#" data-view="matches">
    <span class="nav-link-icon"><svg class="icon"><use href="#i-match"></use></svg></span>
    <span class="nav-link-title">Mecze</span>
  </a>
</li>
<% if (can('admin','designer','social')) { %>
<li class="nav-item">
  <a class="nav-link" href="#" data-view="other">
    <span class="nav-link-icon"><svg class="icon"><use href="#i-other"></use></svg></span>
    <span class="nav-link-title">Inne grafiki</span>
  </a>
</li>
<% } %>

<%
  const libraryItems = [];
  if (can('admin','designer')) libraryItems.push({ view: 'templates', icon: 'i-template', label: 'Szablony' });
  libraryItems.push({ view: 'library', icon: 'i-photos', label: 'Zdjęcia' });
  if (can('admin','designer','social')) libraryItems.push({ view: 'history', icon: 'i-history', label: 'Historia eksportów' });
%>
<li class="nav-item dropdown">
  <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" role="button" aria-expanded="false">
    <span class="nav-link-icon"><svg class="icon"><use href="#i-photos"></use></svg></span>
    <span class="nav-link-title">Biblioteka</span>
  </a>
  <div class="dropdown-menu">
    <% libraryItems.forEach(item => { %>
      <a class="dropdown-item" href="#" data-view="<%= item.view %>">
        <svg class="icon dropdown-item-icon"><use href="#<%= item.icon %>"></use></svg><%= item.label %>
      </a>
    <% }) %>
  </div>
</li>

<% if (can('admin','social') && integrations.facebook.configured) { %>
<li class="nav-item">
  <a class="nav-link" href="#" data-view="social">
    <span class="nav-link-icon"><svg class="icon"><use href="#i-social"></use></svg></span>
    <span class="nav-link-title">Monitoring social</span>
  </a>
</li>
<% } %>
<% if (role === 'admin') { %>
<li class="nav-item">
  <a class="nav-link" href="#" data-view="settings">
    <span class="nav-link-icon"><svg class="icon"><use href="#i-settings"></use></svg></span>
    <span class="nav-link-title">Ustawienia</span>
  </a>
</li>
<% } %>
