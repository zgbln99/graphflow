<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .status-blue { background-color: #dbeafe; color: #1e40af; }
        .status-yellow { background-color: #fef3c7; color: #92400e; }
        .status-orange { background-color: #ffedd5; color: #9a3412; }
        .status-purple { background-color: #f3e8ff; color: #6b21a8; }
        .status-red { background-color: #fee2e2; color: #991b1b; }
        .status-green { background-color: #dcfce7; color: #166534; }
        .status-gray { background-color: #f3f4f6; color: #374151; }
    </style>
</head>
<body class="bg-gray-100 min-h-screen">
<div class="min-h-screen bg-gray-100">
    <%- include('../partials/admin-nav') %>

    <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
        <h1 class="text-2xl font-bold text-gray-900 mb-6">Dashboard</h1>

        <%- include('../partials/flash') %>

        <!-- Statystyki -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow p-6">
                <div class="text-sm font-medium text-gray-500">Wszystkie zlecenia</div>
                <div class="text-3xl font-bold text-gray-900"><%= stats.wszystkie %></div>
            </div>
            <div class="bg-white rounded-lg shadow p-6">
                <div class="text-sm font-medium text-gray-500">Aktywne zlecenia</div>
                <div class="text-3xl font-bold text-indigo-600"><%= stats.aktywne %></div>
            </div>
            <div class="bg-white rounded-lg shadow p-6">
                <div class="text-sm font-medium text-gray-500">Firmy</div>
                <div class="text-3xl font-bold text-gray-900"><%= firmaCount %></div>
            </div>
            <div class="bg-white rounded-lg shadow p-6">
                <div class="text-sm font-medium text-gray-500">Użytkownicy</div>
                <div class="text-3xl font-bold text-gray-900"><%= userCount %></div>
            </div>
        </div>

        <!-- Statusy -->
        <div class="bg-white rounded-lg shadow mb-8">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Zlecenia wg statusu</h2>
            </div>
            <div class="p-6">
                <div class="grid grid-cols-2 md:grid-cols-7 gap-4">
                    <% Object.entries(STATUSY).forEach(function([key, val]) { %>
                    <div class="text-center">
                        <div class="inline-flex items-center justify-center px-3 py-1 rounded-full text-sm status-<%= val.kolor %>">
                            <%= val.nazwa %>
                        </div>
                        <div class="text-2xl font-bold mt-2"><%= stats.statusy[key] || 0 %></div>
                    </div>
                    <% }); %>
                </div>
            </div>
        </div>

        <!-- Ostatnie zlecenia -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                <h2 class="text-lg font-medium text-gray-900">Ostatnie zlecenia</h2>
                <a href="/admin/zlecenia" class="text-indigo-600 hover:text-indigo-800 text-sm">Zobacz wszystkie</a>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Numer</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tytuł</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Firma</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Utworzono</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% if (recentOrders && recentOrders.length > 0) { %>
                            <% recentOrders.forEach(function(order) { %>
                            <tr class="hover:bg-gray-50 cursor-pointer" onclick="window.location='/admin/zlecenie/<%= order.id %>'">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-indigo-600"><%= order.numer %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= helpers.truncate(order.tytul, 40) %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= order.firma_nazwa || '-' %></td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 py-1 text-xs rounded-full status-<%= helpers.statusColor(order.status) %>">
                                        <%= helpers.statusName(order.status) %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= helpers.timeAgo(order.utworzono) %></td>
                            </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="px-6 py-4 text-center text-gray-500">Brak zleceń</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<script>
    async function updateNotificationCount() {
        try {
            const response = await fetch('/api/powiadomienia/count');
            const data = await response.json();
            const badge = document.getElementById('notification-count');
            if (badge && data.success) {
                badge.textContent = data.count;
                badge.style.display = data.count > 0 ? 'inline-flex' : 'none';
            }
        } catch (e) {}
    }
    setInterval(updateNotificationCount, 30000);
    updateNotificationCount();
</script>
</body>
</html>
