<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName || 'GraphFlow' %></title>
    <%- include('../partials/_styles') %>
</head>
<body class="font-sans antialiased bg-slate-50 text-gray-900">
    <%- include('../partials/admin-nav') %>

    <main class="p-6 lg:p-8 animate-fade-in">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-8">
            <div>
                <a href="/admin/zlecenia" class="inline-flex items-center gap-2 text-indigo-600 hover:text-indigo-700 text-sm font-medium mb-3 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Powrót do listy
                </a>
                <h1 class="text-2xl font-bold text-gray-900">Zlecenie <%= order.numer %></h1>
                <p class="text-gray-500 mt-1"><%= order.tytul %></p>
            </div>
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium status-<%= helpers.statusColor(order.status) %>">
                    <%= helpers.statusName(order.status) %>
                </span>
                <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium status-<%= helpers.priorityColor(order.priorytet) %>">
                    <%= helpers.priorityName(order.priorytet) %>
                </span>
            </div>
        </div>

        <!-- Status Timeline -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 mb-6 p-6">
            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Zmień status</h3>
            <div class="flex flex-wrap gap-2">
                <% Object.entries(STATUSY).forEach(function([key, val]) { %>
                <form method="POST" action="/admin/zlecenie/<%= order.id %>/status" class="inline">
                    <input type="hidden" name="status" value="<%= key %>">
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-200
                                   <%= order.status === key ? 'ring-2 ring-offset-2 ring-indigo-500 scale-105' : 'hover:scale-105' %>
                                   status-<%= val.kolor %>"
                            <%= order.status === key ? 'disabled' : '' %>>
                        <% if (key === 'nowe') { %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
                        <% } else if (key === 'w_realizacji') { %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                        <% } else if (key === 'oczekuje') { %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <% } else if (key === 'do_akceptacji') { %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <% } else if (key === 'poprawki') { %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                        <% } else if (key === 'zakonczone') { %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        <% } else if (key === 'anulowane') { %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                        <% } %>
                        <%= val.nazwa %>
                    </button>
                </form>
                <% }); %>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Main Content -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Details Form -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-6 py-5 border-b border-gray-100">
                        <h2 class="text-lg font-semibold text-gray-900">Szczegóły zlecenia</h2>
                    </div>
                    <form method="POST" action="/admin/zlecenie/<%= order.id %>">
                        <div class="p-6 space-y-5">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Tytuł</label>
                                <input type="text" name="tytul" value="<%= order.tytul %>" class="input-field">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Opis</label>
                                <textarea name="opis" rows="4" class="input-field"><%= order.opis || '' %></textarea>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                                    <select name="status" class="input-field">
                                        <% Object.entries(STATUSY).forEach(function([key, val]) { %>
                                        <option value="<%= key %>" <%= order.status === key ? 'selected' : '' %>><%= val.nazwa %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Priorytet</label>
                                    <select name="priorytet" class="input-field">
                                        <% Object.entries(PRIORYTETY).forEach(function([key, val]) { %>
                                        <option value="<%= key %>" <%= order.priorytet === key ? 'selected' : '' %>><%= val.nazwa %></option>
                                        <% }); %>
                                    </select>
                                </div>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Kategoria</label>
                                    <select name="kategoria_id" class="input-field">
                                        <option value="">Brak kategorii</option>
                                        <% categories.forEach(function(cat) { %>
                                        <option value="<%= cat.id %>" <%= order.kategoria_id == cat.id ? 'selected' : '' %>><%= cat.nazwa %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Termin realizacji</label>
                                    <input type="date" name="termin_realizacji"
                                           value="<%= order.termin_realizacji ? new Date(order.termin_realizacji).toISOString().split('T')[0] : '' %>"
                                           class="input-field">
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Notatki wewnętrzne</label>
                                <textarea name="notatki_wewnetrzne" rows="2" class="input-field" placeholder="Widoczne tylko dla zespołu..."><%= order.notatki_wewnetrzne || '' %></textarea>
                            </div>
                        </div>
                        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
                            <button type="submit" class="btn-primary">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                Zapisz zmiany
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Comments -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-6 py-5 border-b border-gray-100">
                        <h2 class="text-lg font-semibold text-gray-900">Komentarze</h2>
                    </div>
                    <div class="p-6">
                        <div class="space-y-4 mb-6">
                            <% if (comments && comments.length) { %>
                                <% comments.forEach(function(c, index) { %>
                                <div class="rounded-xl p-4 animate-slide-up <%= c.typ === 'wewnetrzny' ? 'bg-amber-50 border border-amber-200' : 'bg-gray-50' %>" style="animation-delay: <%= index * 50 %>ms">
                                    <div class="flex items-start justify-between mb-2">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-lg <%= c.typ === 'wewnetrzny' ? 'bg-amber-200 text-amber-700' : 'bg-indigo-100 text-indigo-600' %> flex items-center justify-center text-sm font-semibold">
                                                <%= (c.imie.charAt(0) + c.nazwisko.charAt(0)).toUpperCase() %>
                                            </div>
                                            <div>
                                                <span class="font-medium text-gray-900"><%= c.imie %> <%= c.nazwisko %></span>
                                                <% if (c.typ === 'wewnetrzny') { %>
                                                <span class="ml-2 text-xs bg-amber-200 text-amber-700 px-2 py-0.5 rounded-full">Wewnętrzny</span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <span class="text-xs text-gray-500"><%= helpers.timeAgo(c.utworzono) %></span>
                                    </div>
                                    <div class="text-gray-700 ml-11"><%= c.tresc %></div>
                                </div>
                                <% }); %>
                            <% } else { %>
                                <div class="text-center py-8">
                                    <div class="w-16 h-16 bg-gray-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                                        <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                        </svg>
                                    </div>
                                    <p class="text-gray-500">Brak komentarzy</p>
                                </div>
                            <% } %>
                        </div>

                        <form method="POST" action="/admin/zlecenie/<%= order.id %>/komentarz">
                            <textarea name="tresc" rows="3" placeholder="Napisz komentarz..." class="input-field mb-3"></textarea>
                            <div class="flex items-center justify-between">
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="checkbox" name="typ" value="wewnetrzny" class="w-4 h-4 text-amber-600 border-gray-300 rounded focus:ring-amber-500">
                                    <span class="text-sm text-gray-600">Notatka wewnętrzna (niewidoczna dla klienta)</span>
                                </label>
                                <button type="submit" class="btn-primary text-sm">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                                    </svg>
                                    Wyślij
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Info Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-6 py-5 border-b border-gray-100">
                        <h2 class="text-lg font-semibold text-gray-900">Informacje</h2>
                    </div>
                    <div class="p-6 space-y-5">
                        <div>
                            <div class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Firma</div>
                            <div class="font-medium text-gray-900"><%= order.firma_nazwa || 'Brak' %></div>
                        </div>
                        <div>
                            <div class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Autor</div>
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-500 flex items-center justify-center text-white font-semibold text-sm">
                                    <%= (order.autor_imie.charAt(0) + order.autor_nazwisko.charAt(0)).toUpperCase() %>
                                </div>
                                <div>
                                    <div class="font-medium text-gray-900"><%= order.autor_imie %> <%= order.autor_nazwisko %></div>
                                    <div class="text-sm text-gray-500"><%= order.autor_email %></div>
                                </div>
                            </div>
                        </div>
                        <div class="pt-4 border-t border-gray-100">
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Utworzono</div>
                                    <div class="text-sm font-medium text-gray-900"><%= helpers.formatDatetime(order.utworzono) %></div>
                                </div>
                                <% if (order.zakonczono) { %>
                                <div>
                                    <div class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Zakończono</div>
                                    <div class="text-sm font-medium text-gray-900"><%= helpers.formatDatetime(order.zakonczono) %></div>
                                </div>
                                <% } %>
                            </div>
                        </div>
                        <% if (order.termin_realizacji) { %>
                        <div class="pt-4 border-t border-gray-100">
                            <div class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Termin realizacji</div>
                            <div class="flex items-center gap-2">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span class="font-medium text-gray-900"><%= helpers.formatDate(order.termin_realizacji) %></span>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- History Timeline -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-6 py-5 border-b border-gray-100">
                        <h2 class="text-lg font-semibold text-gray-900">Historia zmian</h2>
                    </div>
                    <div class="p-6">
                        <% if (history && history.length) { %>
                        <div class="relative">
                            <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gray-200"></div>
                            <div class="space-y-6">
                                <% history.forEach(function(h, index) { %>
                                <div class="relative pl-10 animate-slide-up" style="animation-delay: <%= index * 50 %>ms">
                                    <div class="absolute left-2 w-5 h-5 rounded-full bg-white border-2 border-indigo-500 flex items-center justify-center">
                                        <div class="w-2 h-2 rounded-full bg-indigo-500"></div>
                                    </div>
                                    <div class="bg-gray-50 rounded-xl p-3">
                                        <div class="flex flex-wrap items-center gap-2 mb-1">
                                            <% if (h.status_poprzedni) { %>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium status-<%= helpers.statusColor(h.status_poprzedni) %>">
                                                <%= helpers.statusName(h.status_poprzedni) %>
                                            </span>
                                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                            </svg>
                                            <% } %>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium status-<%= helpers.statusColor(h.status_nowy) %>">
                                                <%= helpers.statusName(h.status_nowy) %>
                                            </span>
                                        </div>
                                        <div class="text-xs text-gray-500">
                                            <%= h.imie %> <%= h.nazwisko %> · <%= helpers.timeAgo(h.utworzono) %>
                                        </div>
                                        <% if (h.komentarz) { %>
                                        <div class="text-sm text-gray-600 mt-2 italic">"<%= h.komentarz %>"</div>
                                        <% } %>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                        </div>
                        <% } else { %>
                        <div class="text-center py-6">
                            <p class="text-gray-500 text-sm">Brak historii zmian</p>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/_scripts') %>
</body>
</html>
