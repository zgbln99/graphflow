<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName || 'GraphFlow' %></title>
    <%- include('../partials/_styles') %>
</head>
<body class="font-sans antialiased bg-slate-50 text-gray-900">
    <%- include('../partials/admin-nav') %>

    <main class="p-6 lg:p-8 animate-fade-in">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="mb-8">
            <a href="/admin/firmy" class="inline-flex items-center gap-2 text-gray-500 hover:text-indigo-600 transition-colors mb-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Powrót do listy firm
            </a>
            <h1 class="text-2xl font-bold text-gray-900"><%= firma ? 'Edycja firmy' : 'Nowa firma' %></h1>
            <p class="text-gray-500 mt-1"><%= firma ? 'Zaktualizuj dane firmy' : 'Dodaj nową firmę do systemu' %></p>
        </div>

        <div class="max-w-3xl">
            <!-- Form Card -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100 bg-gradient-to-r from-emerald-50 to-teal-50">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl flex items-center justify-center shadow-lg shadow-emerald-500/30">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                        </div>
                        <div>
                            <h2 class="font-semibold text-gray-900">Dane firmy</h2>
                            <p class="text-sm text-gray-500">Podstawowe informacje o firmie</p>
                        </div>
                    </div>
                </div>

                <form method="POST" action="<%= firma ? '/admin/firma/' + firma.id : '/admin/firma/nowa' %>" class="p-6 space-y-6">
                    <!-- Company Name -->
                    <div>
                        <label for="nazwa" class="block text-sm font-medium text-gray-700 mb-2">
                            Nazwa firmy <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="nazwa" name="nazwa" value="<%= firma ? firma.nazwa : '' %>" required
                               class="input-field" placeholder="np. Firma XYZ Sp. z o.o.">
                    </div>

                    <!-- NIP & Phone -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label for="nip" class="block text-sm font-medium text-gray-700 mb-2">NIP</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                </div>
                                <input type="text" id="nip" name="nip" value="<%= firma ? firma.nip || '' : '' %>"
                                       class="input-field pl-12" placeholder="000-000-00-00">
                            </div>
                        </div>
                        <div>
                            <label for="telefon" class="block text-sm font-medium text-gray-700 mb-2">Telefon</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                    </svg>
                                </div>
                                <input type="tel" id="telefon" name="telefon" value="<%= firma ? firma.telefon || '' : '' %>"
                                       class="input-field pl-12" placeholder="+48 000 000 000">
                            </div>
                        </div>
                    </div>

                    <!-- Email -->
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                            Email <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                                </svg>
                            </div>
                            <input type="email" id="email" name="email" value="<%= firma ? firma.email : '' %>" required
                                   class="input-field pl-12" placeholder="kontakt@firma.pl">
                        </div>
                    </div>

                    <!-- Address -->
                    <div>
                        <label for="adres" class="block text-sm font-medium text-gray-700 mb-2">Adres</label>
                        <div class="relative">
                            <div class="absolute top-3.5 left-4 pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <textarea id="adres" name="adres" rows="2"
                                      class="input-field pl-12 resize-none" placeholder="ul. Przykładowa 1, 00-000 Warszawa"><%= firma ? firma.adres || '' : '' %></textarea>
                        </div>
                    </div>

                    <!-- Internal Notes -->
                    <div>
                        <label for="notatki_wewnetrzne" class="block text-sm font-medium text-gray-700 mb-2">
                            Notatki wewnętrzne
                            <span class="text-gray-400 font-normal ml-1">(widoczne tylko dla administratorów)</span>
                        </label>
                        <textarea id="notatki_wewnetrzne" name="notatki_wewnetrzne" rows="3"
                                  class="input-field resize-none" placeholder="Notatki dotyczące firmy..."><%= firma ? firma.notatki_wewnetrzne || '' : '' %></textarea>
                    </div>

                    <% if (firma) { %>
                    <!-- Active Status -->
                    <div class="bg-gray-50 rounded-xl p-4">
                        <label class="flex items-center justify-between cursor-pointer">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-sm border border-gray-200">
                                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-medium text-gray-900">Firma aktywna</p>
                                    <p class="text-sm text-gray-500">Aktywne firmy mogą składać nowe zlecenia</p>
                                </div>
                            </div>
                            <div class="relative">
                                <input type="checkbox" name="aktywna" value="1" <%= firma.aktywna ? 'checked' : '' %> class="sr-only peer">
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-emerald-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                            </div>
                        </label>
                    </div>
                    <% } %>

                    <!-- Submit Button -->
                    <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                        <a href="/admin/firmy" class="btn-secondary">
                            Anuluj
                        </a>
                        <button type="submit" class="btn-success">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <%= firma ? 'Zapisz zmiany' : 'Utwórz firmę' %>
                        </button>
                    </div>
                </form>
            </div>

            <% if (firma && typeof users !== 'undefined' && users.length > 0) { %>
            <!-- Company Users -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 mt-6 overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-lg font-semibold text-gray-900">Użytkownicy firmy</h2>
                            <p class="text-sm text-gray-500 mt-0.5"><%= users.length %> użytkowników przypisanych do tej firmy</p>
                        </div>
                        <a href="/admin/uzytkownik/nowy?firma_id=<%= firma.id %>" class="btn-secondary text-sm">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            Dodaj użytkownika
                        </a>
                    </div>
                </div>
                <ul class="divide-y divide-gray-100">
                    <% users.forEach(function(u, index) { %>
                    <li class="px-6 py-4 hover:bg-gray-50 transition-colors animate-slide-up" style="animation-delay: <%= index * 50 %>ms">
                        <a href="/admin/uzytkownik/<%= u.id %>" class="flex items-center justify-between group">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center text-white font-semibold text-sm shadow-lg">
                                    <%= u.imie.charAt(0).toUpperCase() %><%= u.nazwisko.charAt(0).toUpperCase() %>
                                </div>
                                <div>
                                    <p class="font-medium text-gray-900 group-hover:text-indigo-600 transition-colors"><%= u.imie %> <%= u.nazwisko %></p>
                                    <p class="text-sm text-gray-500"><%= u.email %></p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium <%= u.aktywny ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                                    <%= u.aktywny ? 'Aktywny' : 'Nieaktywny' %>
                                </span>
                                <svg class="w-5 h-5 text-gray-300 group-hover:text-indigo-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </div>
                        </a>
                    </li>
                    <% }); %>
                </ul>
            </div>
            <% } %>
        </div>
    </main>
</div>

<%- include('../partials/_scripts') %>
</body>
</html>
