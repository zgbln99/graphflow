<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName || 'GraphFlow' %></title>
    <%- include('../partials/_styles') %>
</head>
<body class="font-sans antialiased bg-slate-50 text-gray-900">
    <%- include('../partials/admin-nav') %>

    <main class="p-6 lg:p-8 animate-fade-in">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="mb-8">
            <a href="/admin/uzytkownicy" class="inline-flex items-center gap-2 text-gray-500 hover:text-indigo-600 transition-colors mb-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Powrót do listy użytkowników
            </a>
            <h1 class="text-2xl font-bold text-gray-900"><%= user ? 'Edycja użytkownika' : 'Nowy użytkownik' %></h1>
            <p class="text-gray-500 mt-1"><%= user ? 'Zaktualizuj dane użytkownika' : 'Dodaj nowego użytkownika do systemu' %></p>
        </div>

        <div class="max-w-3xl">
            <!-- Form Card -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100 bg-gradient-to-r from-indigo-50 to-purple-50">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center shadow-lg shadow-indigo-500/30">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                        <div>
                            <h2 class="font-semibold text-gray-900">Dane użytkownika</h2>
                            <p class="text-sm text-gray-500">Podstawowe informacje o użytkowniku</p>
                        </div>
                    </div>
                </div>

                <form method="POST" action="<%= user ? '/admin/uzytkownik/' + user.id : '/admin/uzytkownik/nowy' %>" class="p-6 space-y-6">
                    <!-- First & Last Name -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label for="imie" class="block text-sm font-medium text-gray-700 mb-2">
                                Imię <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                </div>
                                <input type="text" id="imie" name="imie" value="<%= user ? user.imie : '' %>" required
                                       class="input-field pl-12" placeholder="Jan">
                            </div>
                        </div>
                        <div>
                            <label for="nazwisko" class="block text-sm font-medium text-gray-700 mb-2">
                                Nazwisko <span class="text-red-500">*</span>
                            </label>
                            <input type="text" id="nazwisko" name="nazwisko" value="<%= user ? user.nazwisko : '' %>" required
                                   class="input-field" placeholder="Kowalski">
                        </div>
                    </div>

                    <!-- Email -->
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                            Adres e-mail <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                                </svg>
                            </div>
                            <input type="email" id="email" name="email" value="<%= user ? user.email : '' %>" required
                                   class="input-field pl-12" placeholder="jan.kowalski@firma.pl">
                        </div>
                    </div>

                    <!-- Password -->
                    <div>
                        <label for="haslo" class="block text-sm font-medium text-gray-700 mb-2">
                            Hasło <% if (!user) { %><span class="text-red-500">*</span><% } else { %><span class="text-gray-400 font-normal">(pozostaw puste, aby nie zmieniać)</span><% } %>
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                            </div>
                            <input type="password" id="haslo" name="haslo" <%= user ? '' : 'required' %> minlength="6"
                                   class="input-field pl-12" placeholder="<%= user ? '••••••••' : 'Min. 6 znaków' %>">
                        </div>
                        <p class="mt-1.5 text-xs text-gray-500">Hasło musi mieć co najmniej 6 znaków</p>
                    </div>

                    <!-- Phone & Position -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label for="telefon" class="block text-sm font-medium text-gray-700 mb-2">Telefon</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                    </svg>
                                </div>
                                <input type="tel" id="telefon" name="telefon" value="<%= user ? user.telefon || '' : '' %>"
                                       class="input-field pl-12" placeholder="+48 000 000 000">
                            </div>
                        </div>
                        <div>
                            <label for="stanowisko" class="block text-sm font-medium text-gray-700 mb-2">Stanowisko</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <input type="text" id="stanowisko" name="stanowisko" value="<%= user ? user.stanowisko || '' : '' %>"
                                       class="input-field pl-12" placeholder="np. Marketing Manager">
                            </div>
                        </div>
                    </div>

                    <!-- Role & Company -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label for="rola" class="block text-sm font-medium text-gray-700 mb-2">Rola</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                    </svg>
                                </div>
                                <select id="rola" name="rola" class="input-field pl-12 appearance-none">
                                    <option value="klient" <%= user && user.rola === 'klient' ? 'selected' : (!user ? 'selected' : '') %>>Klient</option>
                                    <option value="pracownik" <%= user && user.rola === 'pracownik' ? 'selected' : '' %>>Pracownik</option>
                                    <option value="admin" <%= user && user.rola === 'admin' ? 'selected' : '' %>>Administrator</option>
                                </select>
                                <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <div>
                            <label for="firma_id" class="block text-sm font-medium text-gray-700 mb-2">Firma</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                    </svg>
                                </div>
                                <select id="firma_id" name="firma_id" class="input-field pl-12 appearance-none">
                                    <option value="">— Brak firmy —</option>
                                    <% firmy.forEach(function(f) { %>
                                    <option value="<%= f.id %>" <%= user && user.firma_id == f.id ? 'selected' : '' %>><%= f.nazwa %></option>
                                    <% }); %>
                                </select>
                                <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Role Descriptions -->
                    <div class="bg-gray-50 rounded-xl p-4 space-y-3">
                        <p class="text-sm font-medium text-gray-700">Uprawnienia ról:</p>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
                            <div class="flex items-start gap-2">
                                <span class="inline-flex items-center justify-center w-6 h-6 bg-gray-100 text-gray-600 rounded-lg flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                </span>
                                <div>
                                    <p class="font-medium text-gray-900">Klient</p>
                                    <p class="text-gray-500">Składanie i podgląd zleceń</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-2">
                                <span class="inline-flex items-center justify-center w-6 h-6 bg-blue-100 text-blue-600 rounded-lg flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                    </svg>
                                </span>
                                <div>
                                    <p class="font-medium text-gray-900">Pracownik</p>
                                    <p class="text-gray-500">Realizacja zleceń</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-2">
                                <span class="inline-flex items-center justify-center w-6 h-6 bg-purple-100 text-purple-600 rounded-lg flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                    </svg>
                                </span>
                                <div>
                                    <p class="font-medium text-gray-900">Administrator</p>
                                    <p class="text-gray-500">Pełny dostęp do systemu</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if (user) { %>
                    <!-- Active Status -->
                    <div class="bg-gray-50 rounded-xl p-4">
                        <label class="flex items-center justify-between cursor-pointer">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-sm border border-gray-200">
                                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-medium text-gray-900">Konto aktywne</p>
                                    <p class="text-sm text-gray-500">Aktywni użytkownicy mogą logować się do systemu</p>
                                </div>
                            </div>
                            <div class="relative">
                                <input type="checkbox" name="aktywny" value="1" <%= user.aktywny ? 'checked' : '' %> class="sr-only peer">
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-indigo-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                            </div>
                        </label>
                    </div>
                    <% } %>

                    <!-- Submit Button -->
                    <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                        <a href="/admin/uzytkownicy" class="btn-secondary">
                            Anuluj
                        </a>
                        <button type="submit" class="btn-primary">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <%= user ? 'Zapisz zmiany' : 'Utwórz użytkownika' %>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/_scripts') %>
</body>
</html>
