<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName || 'GraphFlow' %></title>
    <%- include('../partials/_styles') %>
</head>
<body class="font-sans antialiased bg-slate-50 text-gray-900">
    <%- include('../partials/admin-nav') %>

    <main class="p-6 lg:p-8 animate-fade-in">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Firmy</h1>
                <p class="text-gray-500 mt-1">Zarządzaj firmami klientów</p>
            </div>
            <a href="/admin/firma/nowa" class="btn-primary">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Nowa firma
            </a>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 mb-6 p-6">
            <form method="GET" class="flex flex-wrap items-end gap-4">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Szukaj</label>
                    <div class="relative">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text" name="szukaj" value="<%= filters.szukaj || '' %>" placeholder="Nazwa, NIP, email..."
                               class="input-field pl-10">
                    </div>
                </div>
                <div class="w-full sm:w-auto">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                    <select name="aktywna" class="input-field">
                        <option value="">Wszystkie</option>
                        <option value="1" <%= filters.aktywna === 1 ? 'selected' : '' %>>Aktywne</option>
                        <option value="0" <%= filters.aktywna === 0 ? 'selected' : '' %>>Nieaktywne</option>
                    </select>
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="btn-primary">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                        </svg>
                        Filtruj
                    </button>
                    <a href="/admin/firmy" class="btn-secondary">Reset</a>
                </div>
            </form>
        </div>

        <!-- Companies Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% if (firmy && firmy.length) { %>
                <% firmy.forEach(function(f, index) { %>
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden card-hover animate-slide-up" style="animation-delay: <%= index * 50 %>ms">
                    <div class="p-6">
                        <div class="flex items-start justify-between mb-4">
                            <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-teal-500 rounded-xl flex items-center justify-center text-white font-bold text-lg shadow-lg shadow-emerald-500/30">
                                <%= f.nazwa.charAt(0).toUpperCase() %>
                            </div>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium <%= f.aktywna ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                                <%= f.aktywna ? 'Aktywna' : 'Nieaktywna' %>
                            </span>
                        </div>
                        <h3 class="text-lg font-semibold text-gray-900 mb-1">
                            <a href="/admin/firma/<%= f.id %>" class="hover:text-indigo-600 transition-colors"><%= f.nazwa %></a>
                        </h3>
                        <p class="text-sm text-gray-500 mb-4"><%= f.email %></p>

                        <div class="flex items-center gap-4 text-sm text-gray-600">
                            <div class="flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>
                                <span><%= f.liczba_uzytkownikow %> użytk.</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                </svg>
                                <span><%= f.liczba_zlecen %> zleceń</span>
                            </div>
                        </div>
                        <% if (f.nip) { %>
                        <div class="mt-3 text-xs text-gray-500">NIP: <%= f.nip %></div>
                        <% } %>
                    </div>
                    <div class="px-6 py-3 bg-gray-50 border-t border-gray-100 flex justify-between items-center">
                        <a href="/admin/firma/<%= f.id %>" class="text-sm text-indigo-600 hover:text-indigo-700 font-medium transition-colors">
                            Szczegóły
                        </a>
                        <form method="POST" action="/admin/firma/<%= f.id %>/toggle" class="inline">
                            <button type="submit" class="text-sm <%= f.aktywna ? 'text-red-600 hover:text-red-700' : 'text-emerald-600 hover:text-emerald-700' %> font-medium transition-colors">
                                <%= f.aktywna ? 'Dezaktywuj' : 'Aktywuj' %>
                            </button>
                        </form>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
                <div class="col-span-full">
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-12 text-center">
                        <div class="w-20 h-20 bg-gray-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                            <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                        </div>
                        <p class="text-gray-600 font-medium text-lg">Brak firm</p>
                        <p class="text-gray-400 mt-1 mb-6">Dodaj pierwszą firmę, aby rozpocząć</p>
                        <a href="/admin/firma/nowa" class="btn-primary">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            Dodaj firmę
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    </main>
</div>

<%- include('../partials/_scripts') %>
</body>
</html>
