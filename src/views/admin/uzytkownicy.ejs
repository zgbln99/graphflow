<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName || 'GraphFlow' %></title>
    <%- include('../partials/_styles') %>
</head>
<body class="font-sans antialiased bg-slate-50 text-gray-900">
    <%- include('../partials/admin-nav') %>

    <main class="p-6 lg:p-8 animate-fade-in">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Użytkownicy</h1>
                <p class="text-gray-500 mt-1">Zarządzaj użytkownikami systemu</p>
            </div>
            <a href="/admin/uzytkownik/nowy" class="btn-primary">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Nowy użytkownik
            </a>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 mb-6 p-6">
            <form method="GET" class="flex flex-wrap items-end gap-4">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Szukaj</label>
                    <div class="relative">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text" name="szukaj" value="<%= filters.szukaj || '' %>" placeholder="Imię, nazwisko, email..."
                               class="input-field pl-10">
                    </div>
                </div>
                <div class="w-full sm:w-auto">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Rola</label>
                    <select name="rola" class="input-field">
                        <option value="">Wszystkie role</option>
                        <option value="admin" <%= filters.rola === 'admin' ? 'selected' : '' %>>Admin</option>
                        <option value="pracownik" <%= filters.rola === 'pracownik' ? 'selected' : '' %>>Pracownik</option>
                        <option value="klient" <%= filters.rola === 'klient' ? 'selected' : '' %>>Klient</option>
                    </select>
                </div>
                <div class="w-full sm:w-auto">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                    <select name="aktywny" class="input-field">
                        <option value="">Wszyscy</option>
                        <option value="1" <%= filters.aktywny === 1 ? 'selected' : '' %>>Aktywni</option>
                        <option value="0" <%= filters.aktywny === 0 ? 'selected' : '' %>>Nieaktywni</option>
                    </select>
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="btn-primary">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                        </svg>
                        Filtruj
                    </button>
                    <a href="/admin/uzytkownicy" class="btn-secondary">Reset</a>
                </div>
            </form>
        </div>

        <!-- Users Table -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50/80">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Użytkownik</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Email</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Firma</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Rola</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Zlecenia</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-4"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (users && users.length > 0) { %>
                            <% users.forEach(function(u, index) { %>
                            <tr class="border-b border-gray-100 hover:bg-gray-50/50 transition-colors cursor-pointer group animate-slide-up" style="animation-delay: <%= index * 30 %>ms" onclick="window.location='/admin/uzytkownik/<%= u.id %>'">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 bg-gradient-to-br <%= u.rola === 'admin' ? 'from-purple-500 to-indigo-600' : u.rola === 'pracownik' ? 'from-blue-500 to-cyan-500' : 'from-emerald-500 to-teal-500' %> rounded-xl flex items-center justify-center text-white font-semibold text-sm shadow-lg">
                                            <%= u.imie.charAt(0).toUpperCase() %><%= u.nazwisko.charAt(0).toUpperCase() %>
                                        </div>
                                        <div>
                                            <p class="font-semibold text-gray-900"><%= u.imie %> <%= u.nazwisko %></p>
                                            <% if (u.stanowisko) { %>
                                            <p class="text-xs text-gray-500"><%= u.stanowisko %></p>
                                            <% } %>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-gray-600"><%= u.email %></span>
                                </td>
                                <td class="px-6 py-4">
                                    <% if (u.firma_nazwa) { %>
                                    <span class="text-gray-700 font-medium"><%= u.firma_nazwa %></span>
                                    <% } else { %>
                                    <span class="text-gray-400">—</span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium <%= u.rola === 'admin' ? 'bg-purple-100 text-purple-700' : u.rola === 'pracownik' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-700' %>">
                                        <% if (u.rola === 'admin') { %>
                                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                        </svg>
                                        <% } %>
                                        <%= u.rola === 'admin' ? 'Admin' : u.rola === 'pracownik' ? 'Pracownik' : 'Klient' %>
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1 text-gray-700">
                                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                        </svg>
                                        <%= u.liczba_zlecen %>
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium <%= u.aktywny ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                                        <span class="w-1.5 h-1.5 rounded-full mr-1.5 <%= u.aktywny ? 'bg-emerald-500' : 'bg-red-500' %>"></span>
                                        <%= u.aktywny ? 'Aktywny' : 'Nieaktywny' %>
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                        <a href="/admin/uzytkownik/<%= u.id %>" onclick="event.stopPropagation()" class="p-2 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                        </a>
                                        <form method="POST" action="/admin/uzytkownik/<%= u.id %>/toggle" onclick="event.stopPropagation()" class="inline">
                                            <button type="submit" class="p-2 <%= u.aktywny ? 'text-gray-400 hover:text-red-600 hover:bg-red-50' : 'text-gray-400 hover:text-emerald-600 hover:bg-emerald-50' %> rounded-lg transition-colors" title="<%= u.aktywny ? 'Dezaktywuj' : 'Aktywuj' %>">
                                                <% if (u.aktywny) { %>
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                                </svg>
                                                <% } else { %>
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                </svg>
                                                <% } %>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="px-6 py-16 text-center">
                                    <div class="flex flex-col items-center">
                                        <div class="w-20 h-20 bg-gray-100 rounded-2xl flex items-center justify-center mb-4">
                                            <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                            </svg>
                                        </div>
                                        <p class="text-gray-600 font-medium text-lg">Brak użytkowników</p>
                                        <p class="text-gray-400 mt-1 mb-6">Nie znaleziono użytkowników pasujących do kryteriów</p>
                                        <a href="/admin/uzytkownik/nowy" class="btn-primary">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                            </svg>
                                            Dodaj użytkownika
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <div class="px-6 py-4 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="text-sm text-gray-500">
                    Strona <span class="font-medium text-gray-900"><%= page %></span> z <span class="font-medium text-gray-900"><%= totalPages %></span>
                    <span class="text-gray-400 mx-2">•</span>
                    <span class="font-medium text-gray-900"><%= total %></span> użytkowników
                </div>
                <div class="flex items-center gap-2">
                    <% if (page > 1) { %>
                    <a href="?page=<%= page - 1 %><%= filters.szukaj ? '&szukaj=' + filters.szukaj : '' %><%= filters.rola ? '&rola=' + filters.rola : '' %><%= typeof filters.aktywny !== 'undefined' && filters.aktywny !== '' ? '&aktywny=' + filters.aktywny : '' %>"
                       class="btn-secondary text-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                        Poprzednia
                    </a>
                    <% } %>

                    <div class="hidden sm:flex items-center gap-1">
                        <% for (let i = Math.max(1, page - 2); i <= Math.min(totalPages, page + 2); i++) { %>
                        <a href="?page=<%= i %><%= filters.szukaj ? '&szukaj=' + filters.szukaj : '' %><%= filters.rola ? '&rola=' + filters.rola : '' %><%= typeof filters.aktywny !== 'undefined' && filters.aktywny !== '' ? '&aktywny=' + filters.aktywny : '' %>"
                           class="w-10 h-10 flex items-center justify-center rounded-xl text-sm font-medium transition-colors <%= i === page ? 'bg-indigo-600 text-white' : 'hover:bg-gray-100 text-gray-700' %>">
                            <%= i %>
                        </a>
                        <% } %>
                    </div>

                    <% if (page < totalPages) { %>
                    <a href="?page=<%= page + 1 %><%= filters.szukaj ? '&szukaj=' + filters.szukaj : '' %><%= filters.rola ? '&rola=' + filters.rola : '' %><%= typeof filters.aktywny !== 'undefined' && filters.aktywny !== '' ? '&aktywny=' + filters.aktywny : '' %>"
                       class="btn-secondary text-sm">
                        Następna
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                    <% } %>
                </div>
            </div>
            <% } %>
        </div>
    </main>
</div>

<%- include('../partials/_scripts') %>
</body>
</html>
