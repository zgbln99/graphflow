<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .status-blue { background-color: #dbeafe; color: #1e40af; }
        .status-yellow { background-color: #fef3c7; color: #92400e; }
        .status-orange { background-color: #ffedd5; color: #9a3412; }
        .status-purple { background-color: #f3e8ff; color: #6b21a8; }
        .status-red { background-color: #fee2e2; color: #991b1b; }
        .status-green { background-color: #dcfce7; color: #166534; }
        .status-gray { background-color: #f3f4f6; color: #374151; }
    </style>
</head>
<body class="bg-gray-100 min-h-screen">
<div class="min-h-screen bg-gray-100">
    <%- include('../partials/admin-nav') %>

    <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-900">Zlecenia</h1>
        </div>

        <%- include('../partials/flash') %>

        <!-- Filtry -->
        <div class="bg-white rounded-lg shadow mb-6 p-4">
            <form method="GET" class="flex flex-wrap gap-4">
                <div>
                    <input type="text" name="szukaj" value="<%= filters.szukaj || '' %>" placeholder="Szukaj..."
                           class="border border-gray-300 rounded-md px-3 py-2 text-sm">
                </div>
                <div>
                    <select name="status" class="border border-gray-300 rounded-md px-3 py-2 text-sm">
                        <option value="">Wszystkie statusy</option>
                        <% Object.entries(STATUSY).forEach(function([key, val]) { %>
                        <option value="<%= key %>" <%= filters.status === key ? 'selected' : '' %>><%= val.nazwa %></option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <select name="priorytet" class="border border-gray-300 rounded-md px-3 py-2 text-sm">
                        <option value="">Wszystkie priorytety</option>
                        <% Object.entries(PRIORYTETY).forEach(function([key, val]) { %>
                        <option value="<%= key %>" <%= filters.priorytet === key ? 'selected' : '' %>><%= val.nazwa %></option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <select name="firma_id" class="border border-gray-300 rounded-md px-3 py-2 text-sm">
                        <option value="">Wszystkie firmy</option>
                        <% firmy.forEach(function(f) { %>
                        <option value="<%= f.id %>" <%= filters.firma_id == f.id ? 'selected' : '' %>><%= f.nazwa %></option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded-md text-sm hover:bg-indigo-700">
                        Filtruj
                    </button>
                    <a href="/admin/zlecenia" class="text-gray-600 px-4 py-2 text-sm hover:text-gray-800">Reset</a>
                </div>
            </form>
        </div>

        <!-- Tabela -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Numer</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tytuł</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Firma</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Priorytet</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Termin</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% if (orders && orders.length > 0) { %>
                        <% orders.forEach(function(order) { %>
                        <tr class="hover:bg-gray-50 cursor-pointer" onclick="window.location='/admin/zlecenie/<%= order.id %>'">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-indigo-600"><%= order.numer %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= helpers.truncate(order.tytul, 40) %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= order.firma_nazwa || '-' %></td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 py-1 text-xs rounded-full status-<%= helpers.statusColor(order.status) %>">
                                    <%= helpers.statusName(order.status) %>
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 py-1 text-xs rounded-full status-<%= helpers.priorityColor(order.priorytet) %>">
                                    <%= helpers.priorityName(order.priorytet) %>
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                <%= order.termin_realizacji ? helpers.formatDate(order.termin_realizacji) : '-' %>
                            </td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="px-6 py-4 text-center text-gray-500">Brak zleceń</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>

            <% if (totalPages > 1) { %>
            <div class="px-6 py-4 border-t border-gray-200 flex justify-between items-center">
                <div class="text-sm text-gray-500">
                    Strona <%= page %> z <%= totalPages %> (<%= total %> zleceń)
                </div>
                <div class="flex space-x-2">
                    <% if (page > 1) { %>
                    <a href="?page=<%= page - 1 %>" class="px-3 py-1 border rounded hover:bg-gray-100">Poprzednia</a>
                    <% } %>
                    <% if (page < totalPages) { %>
                    <a href="?page=<%= page + 1 %>" class="px-3 py-1 border rounded hover:bg-gray-100">Następna</a>
                    <% } %>
                </div>
            </div>
            <% } %>
        </div>
    </main>
</div>

<script>
    async function updateNotificationCount() {
        try {
            const response = await fetch('/api/powiadomienia/count');
            const data = await response.json();
            const badge = document.getElementById('notification-count');
            if (badge && data.success) {
                badge.textContent = data.count;
                badge.style.display = data.count > 0 ? 'inline-flex' : 'none';
            }
        } catch (e) {}
    }
    setInterval(updateNotificationCount, 30000);
    updateNotificationCount();
</script>
</body>
</html>
