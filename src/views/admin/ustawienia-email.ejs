<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName || 'GraphFlow' %></title>
    <%- include('../partials/_styles') %>
</head>
<body class="font-sans antialiased bg-slate-50 text-gray-900">
    <%- include('../partials/admin-nav') %>

    <main class="p-6 lg:p-8 animate-fade-in">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Ustawienia Email</h1>
                <p class="text-gray-500 mt-1">Konfiguracja SMTP i powiadomien mailowych</p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column - Configuration & Test -->
            <div class="lg:col-span-2 space-y-6">

                <!-- SMTP Configuration Info -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="p-6 border-b border-gray-100">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-indigo-100 rounded-xl flex items-center justify-center">
                                <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-lg font-semibold text-gray-900">Konfiguracja SMTP</h2>
                                <p class="text-sm text-gray-500">Aktualne ustawienia serwera pocztowego</p>
                            </div>
                        </div>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="bg-gray-50 rounded-xl p-4">
                                <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Host SMTP</p>
                                <p class="font-mono text-sm font-medium text-gray-900"><%= emailConfig.host || 'Nie skonfigurowano' %></p>
                            </div>
                            <div class="bg-gray-50 rounded-xl p-4">
                                <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Port</p>
                                <p class="font-mono text-sm font-medium text-gray-900"><%= emailConfig.port || '587' %></p>
                            </div>
                            <div class="bg-gray-50 rounded-xl p-4">
                                <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Uzytkownik SMTP</p>
                                <p class="font-mono text-sm font-medium text-gray-900"><%= emailConfig.user ? '***' + emailConfig.user.slice(-10) : 'Nie ustawiono' %></p>
                            </div>
                            <div class="bg-gray-50 rounded-xl p-4">
                                <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Haslo SMTP</p>
                                <p class="font-mono text-sm font-medium text-gray-900"><%= emailConfig.pass ? '********' : 'Nie ustawiono' %></p>
                            </div>
                            <div class="bg-gray-50 rounded-xl p-4">
                                <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Adres nadawcy</p>
                                <p class="font-mono text-sm font-medium text-gray-900"><%= emailConfig.from || 'Nie ustawiono' %></p>
                            </div>
                            <div class="bg-gray-50 rounded-xl p-4">
                                <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Nazwa nadawcy</p>
                                <p class="font-mono text-sm font-medium text-gray-900"><%= emailConfig.fromName || 'GraphFlow' %></p>
                            </div>
                        </div>

                        <div class="mt-6 p-4 bg-amber-50 border border-amber-200 rounded-xl">
                            <div class="flex gap-3">
                                <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <div class="text-sm">
                                    <p class="font-medium text-amber-800">Jak skonfigurowac SMTP?</p>
                                    <p class="text-amber-700 mt-1">Edytuj plik <code class="bg-amber-100 px-1 rounded">.env</code> w glownym katalogu aplikacji i ustaw zmienne:</p>
                                    <pre class="mt-2 bg-amber-100 p-3 rounded-lg text-xs overflow-x-auto">MAIL_HOST=smtp.twojdomen.pl
MAIL_PORT=587
MAIL_USER=noreply@twojdomen.pl
MAIL_PASS=twoje_haslo
MAIL_FROM=noreply@twojdomen.pl
MAIL_FROM_NAME=GraphFlow</pre>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Test Email -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="p-6 border-b border-gray-100">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center">
                                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-lg font-semibold text-gray-900">Wyslij testowy email</h2>
                                <p class="text-sm text-gray-500">Sprawdz czy konfiguracja dziala poprawnie</p>
                            </div>
                        </div>
                    </div>
                    <form method="POST" action="/admin/ustawienia/email/test" class="p-6">
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Adres email odbiorcy</label>
                            <input type="email" name="test_email" value="<%= user.email %>" required
                                   class="input-field" placeholder="test@example.com">
                        </div>
                        <button type="submit" class="btn-primary">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                            </svg>
                            Wyslij testowy email
                        </button>
                    </form>
                </div>

                <!-- Email Logs -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="p-6 border-b border-gray-100">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-purple-100 rounded-xl flex items-center justify-center">
                                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                </div>
                                <div>
                                    <h2 class="text-lg font-semibold text-gray-900">Historia wysylek</h2>
                                    <p class="text-sm text-gray-500">Ostatnie <%= emailLogs.length %> wiadomosci</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="divide-y divide-gray-100 max-h-[500px] overflow-y-auto">
                        <% if (emailLogs && emailLogs.length) { %>
                            <% emailLogs.forEach(function(log) { %>
                            <div class="p-4 hover:bg-gray-50 transition-colors">
                                <div class="flex items-start justify-between gap-4">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2 mb-1">
                                            <% if (log.status === 'wyslany') { %>
                                                <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
                                            <% } else if (log.status === 'blad') { %>
                                                <span class="w-2 h-2 bg-red-500 rounded-full"></span>
                                            <% } else { %>
                                                <span class="w-2 h-2 bg-amber-500 rounded-full"></span>
                                            <% } %>
                                            <p class="font-medium text-gray-900 truncate"><%= log.temat %></p>
                                        </div>
                                        <p class="text-sm text-gray-500 truncate">Do: <%= log.odbiorca %></p>
                                        <% if (log.blad_info) { %>
                                            <p class="text-xs text-red-600 mt-1"><%= log.blad_info %></p>
                                        <% } %>
                                    </div>
                                    <div class="text-right flex-shrink-0">
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium
                                            <% if (log.status === 'wyslany') { %>bg-emerald-100 text-emerald-700
                                            <% } else if (log.status === 'blad') { %>bg-red-100 text-red-700
                                            <% } else { %>bg-amber-100 text-amber-700<% } %>">
                                            <%= log.status === 'wyslany' ? 'Wyslany' : log.status === 'blad' ? 'Blad' : 'Oczekuje' %>
                                        </span>
                                        <p class="text-xs text-gray-400 mt-1"><%= helpers.timeAgo(log.utworzono) %></p>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <div class="p-12 text-center">
                                <div class="w-16 h-16 bg-gray-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                                    <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <p class="text-gray-500">Brak historii wysylek</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Right Column - Quick Guide & Stats -->
            <div class="space-y-6">

                <!-- Email Stats -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                    <h3 class="font-semibold text-gray-900 mb-4">Statystyki (ostatnie 30 dni)</h3>
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center">
                                    <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                </div>
                                <span class="text-gray-600">Wyslane</span>
                            </div>
                            <span class="text-xl font-bold text-emerald-600"><%= emailStats.sent || 0 %></span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center">
                                    <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </div>
                                <span class="text-gray-600">Bledy</span>
                            </div>
                            <span class="text-xl font-bold text-red-600"><%= emailStats.failed || 0 %></span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 bg-amber-100 rounded-lg flex items-center justify-center">
                                    <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <span class="text-gray-600">Oczekujace</span>
                            </div>
                            <span class="text-xl font-bold text-amber-600"><%= emailStats.pending || 0 %></span>
                        </div>
                    </div>
                    <% if (emailStats.sent > 0 || emailStats.failed > 0) { %>
                    <div class="mt-4 pt-4 border-t border-gray-100">
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-gray-500">Wskaznik sukcesu</span>
                            <span class="font-semibold text-gray-900">
                                <%= Math.round((emailStats.sent / (emailStats.sent + emailStats.failed)) * 100) %>%
                            </span>
                        </div>
                        <div class="mt-2 h-2 bg-gray-100 rounded-full overflow-hidden">
                            <div class="h-full bg-emerald-500 rounded-full" style="width: <%= Math.round((emailStats.sent / (emailStats.sent + emailStats.failed)) * 100) %>%"></div>
                        </div>
                    </div>
                    <% } %>
                </div>

                <!-- Popular SMTP Providers -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                    <h3 class="font-semibold text-gray-900 mb-4">Popularne serwery SMTP</h3>
                    <div class="space-y-3">
                        <div class="p-3 bg-gray-50 rounded-xl">
                            <p class="font-medium text-gray-900 text-sm">Gmail</p>
                            <p class="text-xs text-gray-500 font-mono mt-1">smtp.gmail.com:587</p>
                        </div>
                        <div class="p-3 bg-gray-50 rounded-xl">
                            <p class="font-medium text-gray-900 text-sm">Outlook / Office 365</p>
                            <p class="text-xs text-gray-500 font-mono mt-1">smtp.office365.com:587</p>
                        </div>
                        <div class="p-3 bg-gray-50 rounded-xl">
                            <p class="font-medium text-gray-900 text-sm">SendGrid</p>
                            <p class="text-xs text-gray-500 font-mono mt-1">smtp.sendgrid.net:587</p>
                        </div>
                        <div class="p-3 bg-gray-50 rounded-xl">
                            <p class="font-medium text-gray-900 text-sm">Mailgun</p>
                            <p class="text-xs text-gray-500 font-mono mt-1">smtp.mailgun.org:587</p>
                        </div>
                    </div>
                </div>

                <!-- Email Types Info -->
                <div class="bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl p-6 text-white">
                    <h3 class="font-semibold mb-3">Automatyczne powiadomienia</h3>
                    <ul class="space-y-2 text-sm text-indigo-100">
                        <li class="flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            Nowe zlecenie
                        </li>
                        <li class="flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            Zmiana statusu zlecenia
                        </li>
                        <li class="flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            Nowy komentarz
                        </li>
                        <li class="flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            Zlecenie zakonczone
                        </li>
                        <li class="flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            Przypomnienia o terminach
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/_scripts') %>
</body>
</html>
