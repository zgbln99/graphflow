<%- include('layouts/main', { body: `
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full text-center">
        <h1 class="text-6xl font-bold text-gray-300 mb-4">Oops!</h1>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">${title}</h2>
        <p class="text-gray-600 mb-8">${message}</p>

        ${error ? `
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-left mb-8">
            <pre class="text-sm text-red-800 overflow-auto">${error.stack || error.message || error}</pre>
        </div>
        ` : ''}

        <div class="space-x-4">
            <a href="javascript:history.back()" class="text-indigo-600 hover:text-indigo-800">
                ← Wróć
            </a>
            <a href="/" class="text-indigo-600 hover:text-indigo-800">
                Strona główna
            </a>
        </div>
    </div>
</div>
`}) %>
