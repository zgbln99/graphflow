<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Przypomnij haslo - <%= appName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            50: '#f5f3ff',
                            100: '#ede9fe',
                            200: '#ddd6fe',
                            300: '#c4b5fd',
                            400: '#a78bfa',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                            700: '#6d28d9',
                            800: '#5b21b6',
                            900: '#4c1d95',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .auth-gradient {
            background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 50%, #4c1d95 100%);
        }
        .floating {
            animation: floating 6s ease-in-out infinite;
        }
        .floating-delayed {
            animation: floating 6s ease-in-out infinite;
            animation-delay: 2s;
        }
        .floating-slow {
            animation: floating 8s ease-in-out infinite;
            animation-delay: 4s;
        }
        @keyframes floating {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(3deg); }
        }
        .pattern-dots {
            background-image: radial-gradient(rgba(255,255,255,0.15) 1px, transparent 1px);
            background-size: 20px 20px;
        }
        input:focus {
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
        }
        .btn-primary {
            background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
            transition: all 0.3s ease;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #6d28d9 0%, #5b21b6 100%);
            transform: translateY(-1px);
            box-shadow: 0 10px 25px -5px rgba(124, 58, 237, 0.4);
        }
    </style>
</head>
<body class="font-sans antialiased bg-gray-50">
    <div class="min-h-screen flex">
        <!-- Left Side - Branding -->
        <div class="hidden lg:flex lg:w-1/2 auth-gradient relative overflow-hidden">
            <div class="pattern-dots absolute inset-0"></div>

            <!-- Floating Elements -->
            <div class="absolute inset-0 overflow-hidden">
                <div class="floating absolute top-20 left-20 w-32 h-32 bg-white/10 rounded-3xl backdrop-blur-sm"></div>
                <div class="floating-delayed absolute top-40 right-32 w-24 h-24 bg-white/10 rounded-2xl backdrop-blur-sm"></div>
                <div class="floating-slow absolute bottom-32 left-40 w-20 h-20 bg-white/10 rounded-xl backdrop-blur-sm"></div>
                <div class="floating absolute bottom-20 right-20 w-28 h-28 bg-white/10 rounded-3xl backdrop-blur-sm"></div>
            </div>

            <div class="relative z-10 flex flex-col justify-center px-12 xl:px-20">
                <!-- Logo -->
                <div class="flex items-center gap-4 mb-12">
                    <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center shadow-xl">
                        <svg class="w-8 h-8 text-primary-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-white"><%= appName %></h1>
                        <p class="text-primary-200 text-sm">Panel Administracyjny</p>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="max-w-md">
                    <h2 class="text-4xl xl:text-5xl font-bold text-white leading-tight mb-6">
                        Odzyskaj dostep do konta
                    </h2>
                    <p class="text-primary-200 text-lg leading-relaxed mb-10">
                        Wyslemy Ci link do resetowania hasla na podany adres e-mail. Link bedzie wazny przez 24 godziny.
                    </p>

                    <!-- Security Info -->
                    <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6">
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center flex-shrink-0">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-white font-semibold mb-1">Bezpieczenstwo danych</h3>
                                <p class="text-primary-200 text-sm">Twoje dane sa bezpieczne. Link do resetowania hasla jest jednorazowy i wygasa automatycznie.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side - Form -->
        <div class="flex-1 flex items-center justify-center p-6 sm:p-12">
            <div class="w-full max-w-md">
                <!-- Mobile Logo -->
                <div class="lg:hidden flex items-center justify-center gap-3 mb-10">
                    <div class="w-12 h-12 auth-gradient rounded-xl flex items-center justify-center">
                        <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                        </svg>
                    </div>
                    <span class="text-xl font-bold text-gray-900"><%= appName %></span>
                </div>

                <!-- Header -->
                <div class="mb-8">
                    <div class="w-14 h-14 bg-primary-100 rounded-2xl flex items-center justify-center mb-6">
                        <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                        </svg>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Przypomnij haslo</h2>
                    <p class="text-gray-500">Podaj adres e-mail powiazany z Twoim kontem</p>
                </div>

                <!-- Error Message -->
                <% if (typeof error !== 'undefined' && error && error.length) { %>
                <div class="mb-6 p-4 bg-red-50 border border-red-100 rounded-xl flex items-start gap-3">
                    <div class="w-5 h-5 mt-0.5">
                        <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-red-800 font-medium text-sm">Wystapil blad</p>
                        <p class="text-red-600 text-sm mt-0.5"><%= error[0] %></p>
                    </div>
                </div>
                <% } %>

                <!-- Success Message -->
                <% if (typeof success !== 'undefined' && success && success.length) { %>
                <div class="mb-6 p-4 bg-green-50 border border-green-100 rounded-xl flex items-start gap-3">
                    <div class="w-5 h-5 mt-0.5">
                        <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-green-800 font-medium text-sm">Email wyslany</p>
                        <p class="text-green-600 text-sm mt-0.5"><%= success[0] %></p>
                    </div>
                </div>
                <% } %>

                <!-- Form -->
                <form method="POST" action="/forgot-password" class="space-y-5">
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Adres e-mail</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-all text-gray-900 placeholder-gray-400"
                            placeholder="jan@firma.pl"
                            required
                        >
                    </div>

                    <button
                        type="submit"
                        class="w-full py-3.5 px-4 btn-primary text-white font-semibold rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
                    >
                        Wyslij link resetujacy
                    </button>
                </form>

                <!-- Back to Login -->
                <div class="mt-8 text-center">
                    <a href="/login" class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-900 font-medium transition-colors group">
                        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Powrot do logowania
                    </a>
                </div>

                <!-- Footer -->
                <div class="mt-12 text-center">
                    <p class="text-xs text-gray-400">
                        &copy; <%= new Date().getFullYear() %> <%= appName %>. Wszystkie prawa zastrzezone.
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
