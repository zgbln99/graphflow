<%- include('layouts/main', { body: `
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <h1 class="text-center text-3xl font-extrabold text-gray-900">GraphFlow</h1>
            <h2 class="mt-6 text-center text-xl text-gray-600">Przypomnij hasło</h2>
        </div>

        ${typeof error !== 'undefined' && error && error.length ? error.map(msg => `
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded" role="alert">
            <span>${msg}</span>
        </div>
        `).join('') : ''}

        ${typeof success !== 'undefined' && success && success.length ? success.map(msg => `
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded" role="alert">
            <span>${msg}</span>
        </div>
        `).join('') : ''}

        <form class="mt-8 space-y-6" action="/forgot-password" method="POST">
            <div>
                <label for="email" class="sr-only">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required
                       class="appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm"
                       placeholder="Adres email">
            </div>

            <div>
                <button type="submit"
                        class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Wyślij link resetujący
                </button>
            </div>

            <div class="text-center">
                <a href="/login" class="text-sm text-indigo-600 hover:text-indigo-500">
                    ← Powrót do logowania
                </a>
            </div>
        </form>
    </div>
</div>
`}) %>
