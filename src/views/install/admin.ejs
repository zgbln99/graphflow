<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | GraphFlow</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-indigo-100 via-purple-50 to-pink-100 min-h-screen">
    <div class="min-h-screen flex flex-col items-center justify-center py-12 px-4">
        <div class="w-full max-w-2xl">
            <div class="text-center mb-8">
                <h1 class="text-4xl font-bold text-indigo-600">GraphFlow</h1>
                <p class="text-gray-600 mt-2">Panel Zleceń Graficznych</p>
            </div>

            <%- include('_progress', { step: step, totalSteps: totalSteps }) %>

            <div class="bg-white rounded-xl shadow-xl overflow-hidden">
                <div class="p-8">
                    <div class="mb-6">
                        <h2 class="text-2xl font-bold text-gray-900 mb-2">Konto administratora</h2>
                        <p class="text-gray-600">Utwórz główne konto administratora systemu.</p>
                    </div>

                    <% if (error) { %>
                    <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                        <div class="flex">
                            <svg class="w-5 h-5 text-red-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <div class="text-sm text-red-800"><%= error %></div>
                        </div>
                    </div>
                    <% } %>

                    <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
                        <div class="flex">
                            <svg class="w-5 h-5 text-green-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <div class="text-sm text-green-800">
                                <strong>Sukces!</strong> Baza danych została skonfigurowana i tabele zostały utworzone.
                            </div>
                        </div>
                    </div>

                    <form method="POST" action="/install/admin" class="space-y-6">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Imię *</label>
                                <input type="text" name="firstName" value="<%= admin.firstName %>" required
                                       class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                       placeholder="Jan">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Nazwisko *</label>
                                <input type="text" name="lastName" value="<%= admin.lastName %>" required
                                       class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                       placeholder="Kowalski">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Adres email *</label>
                            <input type="email" name="email" value="<%= admin.email %>" required
                                   class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                   placeholder="admin@example.com">
                            <p class="text-xs text-gray-500 mt-1">Ten adres będzie używany do logowania.</p>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Hasło *</label>
                                <input type="password" name="password" required minlength="6"
                                       class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                       placeholder="Minimum 6 znaków">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Powtórz hasło *</label>
                                <input type="password" name="password_confirm" required minlength="6"
                                       class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                       placeholder="Powtórz hasło">
                            </div>
                        </div>

                        <div class="bg-yellow-50 rounded-lg p-4">
                            <div class="flex">
                                <svg class="w-5 h-5 text-yellow-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                </svg>
                                <div class="text-sm text-yellow-800">
                                    <strong>Ważne:</strong> Zapamiętaj te dane logowania - będą potrzebne do pierwszego logowania.
                                </div>
                            </div>
                        </div>

                        <div class="flex justify-between pt-4">
                            <a href="/install/database" class="text-gray-600 px-4 py-2 hover:text-gray-800">
                                <svg class="w-5 h-5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                                </svg>
                                Wstecz
                            </a>
                            <button type="submit" class="bg-indigo-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-indigo-700 transition-colors">
                                Utwórz konto
                                <svg class="w-5 h-5 inline ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                </svg>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-6 text-sm text-gray-500">
                GraphFlow v1.0
            </div>
        </div>
    </div>
</body>
</html>
