<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | GraphFlow</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-indigo-100 via-purple-50 to-pink-100 min-h-screen">
    <div class="min-h-screen flex flex-col items-center justify-center py-12 px-4">
        <div class="w-full max-w-2xl">
            <div class="text-center mb-8">
                <h1 class="text-4xl font-bold text-indigo-600">GraphFlow</h1>
                <p class="text-gray-600 mt-2">Panel Zleceń Graficznych</p>
            </div>

            <%- include('_progress', { step: step, totalSteps: totalSteps }) %>

            <div class="bg-white rounded-xl shadow-xl overflow-hidden">
                <div class="p-8">
                    <div class="mb-6">
                        <h2 class="text-2xl font-bold text-gray-900 mb-2">Konfiguracja aplikacji</h2>
                        <p class="text-gray-600">Ostatnie ustawienia przed zakończeniem instalacji.</p>
                    </div>

                    <% if (typeof error !== 'undefined' && error) { %>
                    <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                        <div class="flex">
                            <svg class="w-5 h-5 text-red-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <div class="text-sm text-red-800"><%= error %></div>
                        </div>
                    </div>
                    <% } %>

                    <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
                        <div class="flex">
                            <svg class="w-5 h-5 text-green-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <div class="text-sm text-green-800">
                                <strong>Sukces!</strong> Konto administratora zostało utworzone.
                            </div>
                        </div>
                    </div>

                    <form method="POST" action="/install/app" class="space-y-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Nazwa aplikacji</label>
                            <input type="text" name="name" value="<%= app.name %>"
                                   class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                   placeholder="GraphFlow">
                            <p class="text-xs text-gray-500 mt-1">Nazwa wyświetlana w nagłówku i tytułach stron.</p>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">URL aplikacji</label>
                            <input type="url" name="url" value="<%= app.url %>"
                                   class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                   placeholder="http://localhost:3000">
                            <p class="text-xs text-gray-500 mt-1">Pełny adres URL, pod którym aplikacja będzie dostępna.</p>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Port aplikacji</label>
                            <input type="number" name="port" value="<%= app.port %>" min="1" max="65535"
                                   class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                                   placeholder="3000">
                            <p class="text-xs text-gray-500 mt-1">Port, na którym będzie nasłuchiwał serwer Node.js.</p>
                        </div>

                        <div class="bg-blue-50 rounded-lg p-4">
                            <div class="flex">
                                <svg class="w-5 h-5 text-blue-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <div class="text-sm text-blue-800">
                                    Po zakończeniu instalacji zostanie utworzony plik <code class="bg-blue-100 px-1 rounded">.env</code>
                                    z całą konfiguracją. Możesz go później edytować ręcznie.
                                </div>
                            </div>
                        </div>

                        <div class="flex justify-between pt-4">
                            <a href="/install/admin" class="text-gray-600 px-4 py-2 hover:text-gray-800">
                                <svg class="w-5 h-5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                                </svg>
                                Wstecz
                            </a>
                            <button type="submit" class="bg-green-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-green-700 transition-colors">
                                Zakończ instalację
                                <svg class="w-5 h-5 inline ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-6 text-sm text-gray-500">
                GraphFlow v1.0
            </div>
        </div>
    </div>
</body>
</html>
