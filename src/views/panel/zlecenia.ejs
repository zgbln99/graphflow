<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName || 'GraphFlow' %></title>
    <%- include('../partials/_styles') %>
</head>
<body class="font-sans antialiased bg-slate-50 text-gray-900">
    <%- include('../partials/panel-nav') %>

    <main class="p-6 lg:p-8 animate-fade-in">
        <%- include('../partials/flash') %>

        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Moje zlecenia</h1>
                <p class="text-gray-500 mt-1">Wszystkie Twoje zlecenia graficzne</p>
            </div>
            <a href="/panel/nowe-zlecenie" class="btn-success">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Nowe zlecenie
            </a>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 mb-6 p-6">
            <form method="GET" class="flex flex-wrap items-end gap-4">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Szukaj</label>
                    <div class="relative">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text" name="szukaj" value="<%= filters.szukaj || '' %>" placeholder="Szukaj zlecenia..."
                               class="input-field pl-10">
                    </div>
                </div>
                <div class="w-full sm:w-auto">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                    <select name="status" class="input-field">
                        <option value="">Wszystkie statusy</option>
                        <% Object.entries(STATUSY).forEach(function([key, val]) { %>
                        <option value="<%= key %>" <%= filters.status === key ? 'selected' : '' %>><%= val.nazwa %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="btn-success">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                        </svg>
                        Filtruj
                    </button>
                    <a href="/panel/zlecenia" class="btn-secondary">Reset</a>
                </div>
            </form>
        </div>

        <!-- Orders -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50/80">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Numer</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Tytuł</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Kategoria</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Termin</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Utworzono</th>
                            <th class="px-6 py-4"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders && orders.length > 0) { %>
                            <% orders.forEach(function(order, index) { %>
                            <tr class="border-b border-gray-100 hover:bg-gray-50/50 transition-colors cursor-pointer group animate-slide-up" style="animation-delay: <%= index * 30 %>ms" onclick="window.location='/panel/zlecenie/<%= order.id %>'">
                                <td class="px-6 py-4">
                                    <span class="font-semibold text-emerald-600"><%= order.numer %></span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="font-medium text-gray-900"><%= helpers.truncate(order.tytul, 40) %></span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-gray-500"><%= order.kategoria_nazwa || '-' %></span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium status-<%= helpers.statusColor(order.status) %>">
                                        <%= helpers.statusName(order.status) %>
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <% if (order.termin_realizacji) { %>
                                    <span class="text-gray-700"><%= helpers.formatDate(order.termin_realizacji) %></span>
                                    <% } else { %>
                                    <span class="text-gray-400">-</span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-gray-500"><%= helpers.timeAgo(order.utworzono) %></span>
                                </td>
                                <td class="px-6 py-4">
                                    <svg class="w-5 h-5 text-gray-300 group-hover:text-emerald-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                    </svg>
                                </td>
                            </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="px-6 py-16 text-center">
                                    <div class="flex flex-col items-center">
                                        <div class="w-20 h-20 bg-gray-100 rounded-2xl flex items-center justify-center mb-4">
                                            <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                            </svg>
                                        </div>
                                        <p class="text-gray-600 font-medium text-lg">Brak zleceń</p>
                                        <p class="text-gray-400 mt-1 mb-6">Nie znaleziono zleceń pasujących do kryteriów</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (totalPages > 1) { %>
            <div class="px-6 py-4 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="text-sm text-gray-500">
                    Strona <span class="font-medium text-gray-900"><%= page %></span> z <span class="font-medium text-gray-900"><%= totalPages %></span>
                    <span class="text-gray-400 mx-2">•</span>
                    <span class="font-medium text-gray-900"><%= total %></span> zleceń
                </div>
                <div class="flex items-center gap-2">
                    <% if (page > 1) { %>
                    <a href="?page=<%= page - 1 %><%= filters.szukaj ? '&szukaj=' + filters.szukaj : '' %><%= filters.status ? '&status=' + filters.status : '' %>" class="btn-secondary text-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                        Poprzednia
                    </a>
                    <% } %>
                    <% if (page < totalPages) { %>
                    <a href="?page=<%= page + 1 %><%= filters.szukaj ? '&szukaj=' + filters.szukaj : '' %><%= filters.status ? '&status=' + filters.status : '' %>" class="btn-secondary text-sm">
                        Następna
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                    <% } %>
                </div>
            </div>
            <% } %>
        </div>
    </main>
</div>

<%- include('../partials/_scripts') %>
</body>
</html>
