<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName || 'GraphFlow' %></title>
    <%- include('../partials/_styles') %>
</head>
<body class="font-sans antialiased bg-slate-50 text-gray-900">
    <%- include('../partials/panel-nav') %>

    <main class="p-6 lg:p-8 animate-fade-in">
        <%- include('../partials/flash') %>

        <div class="max-w-3xl mx-auto">
            <!-- Header -->
            <div class="mb-8">
                <a href="/panel/zlecenia" class="inline-flex items-center gap-2 text-emerald-600 hover:text-emerald-700 text-sm font-medium mb-3 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Powrót do listy
                </a>
                <h1 class="text-2xl font-bold text-gray-900">Nowe zlecenie</h1>
                <p class="text-gray-500 mt-1">Wypełnij formularz, aby złożyć nowe zlecenie graficzne</p>
            </div>

            <!-- Form -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <form method="POST" action="/panel/nowe-zlecenie">
                    <div class="p-6 space-y-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Tytuł zlecenia <span class="text-red-500">*</span>
                            </label>
                            <input type="text" name="tytul" required placeholder="Np. Logo dla nowej firmy" class="input-field">
                            <p class="mt-1.5 text-sm text-gray-500">Krótki, opisowy tytuł Twojego zlecenia</p>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Opis zlecenia <span class="text-red-500">*</span>
                            </label>
                            <textarea name="opis" rows="6" required
                                      placeholder="Opisz szczegółowo czego potrzebujesz. Im więcej informacji podasz, tym lepiej będziemy mogli zrealizować zlecenie."
                                      class="input-field"></textarea>
                            <p class="mt-1.5 text-sm text-gray-500">Podaj jak najwięcej szczegółów: kolory, styl, wymiary, inspiracje itp.</p>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Kategoria</label>
                                <select name="kategoria_id" class="input-field">
                                    <option value="">Wybierz kategorię</option>
                                    <% categories.forEach(function(cat) { %>
                                    <option value="<%= cat.id %>"><%= cat.nazwa %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Priorytet</label>
                                <select name="priorytet" class="input-field">
                                    <% Object.entries(PRIORYTETY).forEach(function([key, val]) { %>
                                    <option value="<%= key %>" <%= key === 'normalny' ? 'selected' : '' %>><%= val.nazwa %></option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Oczekiwany termin realizacji</label>
                            <input type="date" name="termin_realizacji" class="input-field">
                            <p class="mt-1.5 text-sm text-gray-500">Opcjonalnie. Jeśli potrzebujesz realizacji na konkretną datę.</p>
                        </div>
                    </div>

                    <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
                        <button type="submit" class="w-full sm:w-auto btn-success text-base py-3 px-8">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                            </svg>
                            Złóż zlecenie
                        </button>
                    </div>
                </form>
            </div>

            <!-- Info Card -->
            <div class="mt-6 bg-emerald-50 rounded-2xl p-6 border border-emerald-100">
                <div class="flex gap-4">
                    <div class="flex-shrink-0 w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center">
                        <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-medium text-emerald-900">Co dalej?</h3>
                        <p class="text-sm text-emerald-700 mt-1">
                            Po złożeniu zlecenia otrzymasz potwierdzenie. Nasz zespół przeanalizuje Twoje wymagania
                            i skontaktuje się z Tobą w przypadku pytań. Możesz śledzić status zlecenia w panelu.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/_scripts') %>
</body>
</html>
