<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName || 'GraphFlow' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-out',
                        'slide-up': 'slideUp 0.5s ease-out',
                        'slide-down': 'slideDown 0.3s ease-out',
                        'slide-in-right': 'slideInRight 0.3s ease-out',
                        'scale-in': 'scaleIn 0.2s ease-out',
                        'pulse-slow': 'pulse 3s infinite',
                        'bounce-slow': 'bounce 2s infinite',
                        'shimmer': 'shimmer 2s infinite',
                    },
                }
            }
        }
    </script>
    <style>
        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes slideInRight {
            from { opacity: 0; transform: translateX(20px); }
            to { opacity: 1; transform: translateX(0); }
        }
        @keyframes scaleIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        /* Status badges */
        .status-badge {
            @apply inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium transition-all duration-200;
        }
        .status-blue { @apply bg-blue-100 text-blue-700 ring-1 ring-blue-600/20; }
        .status-yellow { @apply bg-amber-100 text-amber-700 ring-1 ring-amber-600/20; }
        .status-orange { @apply bg-orange-100 text-orange-700 ring-1 ring-orange-600/20; }
        .status-purple { @apply bg-purple-100 text-purple-700 ring-1 ring-purple-600/20; }
        .status-red { @apply bg-red-100 text-red-700 ring-1 ring-red-600/20; }
        .status-green { @apply bg-emerald-100 text-emerald-700 ring-1 ring-emerald-600/20; }
        .status-gray { @apply bg-slate-100 text-slate-700 ring-1 ring-slate-600/20; }

        /* Priority badges */
        .priority-niski { @apply bg-slate-100 text-slate-600; }
        .priority-normalny { @apply bg-blue-100 text-blue-600; }
        .priority-wysoki { @apply bg-orange-100 text-orange-600; }
        .priority-pilny { @apply bg-red-100 text-red-600 animate-pulse-slow; }

        /* Glass effect */
        .glass {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        /* Card hover effects */
        .card-hover {
            @apply transition-all duration-300 hover:shadow-lg hover:-translate-y-1;
        }

        /* Gradient text */
        .gradient-text {
            @apply bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent;
        }

        /* Button styles */
        .btn-primary {
            @apply inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-medium rounded-xl hover:from-indigo-700 hover:to-purple-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-all duration-200 hover:shadow-lg hover:shadow-indigo-500/25 active:scale-[0.98];
        }
        .btn-secondary {
            @apply inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-white text-gray-700 font-medium rounded-xl border border-gray-200 hover:bg-gray-50 hover:border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-all duration-200 active:scale-[0.98];
        }
        .btn-success {
            @apply inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-medium rounded-xl hover:from-emerald-700 hover:to-teal-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 transition-all duration-200 hover:shadow-lg hover:shadow-emerald-500/25 active:scale-[0.98];
        }
        .btn-danger {
            @apply inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-red-600 to-rose-600 text-white font-medium rounded-xl hover:from-red-700 hover:to-rose-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-all duration-200 hover:shadow-lg hover:shadow-red-500/25 active:scale-[0.98];
        }

        /* Input styles */
        .input-field {
            @apply w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-200;
        }

        /* Table styles */
        .table-modern {
            @apply w-full;
        }
        .table-modern thead {
            @apply bg-gray-50/80;
        }
        .table-modern th {
            @apply px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider;
        }
        .table-modern td {
            @apply px-6 py-4 text-sm text-gray-700;
        }
        .table-modern tbody tr {
            @apply border-b border-gray-100 hover:bg-gray-50/50 transition-colors duration-150;
        }

        /* Sidebar active state */
        .nav-link {
            @apply flex items-center gap-3 px-4 py-3 text-gray-600 rounded-xl transition-all duration-200 hover:bg-gray-100 hover:text-gray-900;
        }
        .nav-link.active {
            @apply bg-gradient-to-r from-indigo-50 to-purple-50 text-indigo-700 font-medium;
        }
        .nav-link.active svg {
            @apply text-indigo-600;
        }

        /* Dropdown animation */
        .dropdown-menu {
            @apply absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-lg ring-1 ring-black/5 py-2 opacity-0 invisible transform scale-95 transition-all duration-200 origin-top-right z-50;
        }
        .dropdown:hover .dropdown-menu,
        .dropdown:focus-within .dropdown-menu {
            @apply opacity-100 visible scale-100;
        }

        /* Loading skeleton */
        .skeleton {
            @apply animate-pulse bg-gray-200 rounded;
        }

        /* Notification dot */
        .notification-dot {
            @apply absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs font-bold rounded-full flex items-center justify-center ring-2 ring-white;
        }
    </style>
</head>
<body class="font-sans antialiased bg-slate-50 text-gray-900">
    <%- body %>

    <script>
        // Notification count updater
        async function updateNotificationCount() {
            try {
                const response = await fetch('/api/powiadomienia/count');
                const data = await response.json();
                const badge = document.getElementById('notification-count');
                if (badge && data.success) {
                    badge.textContent = data.count;
                    badge.style.display = data.count > 0 ? 'flex' : 'none';
                    if (data.count > 0) {
                        badge.classList.add('animate-bounce-slow');
                    }
                }
            } catch (e) {
                console.error('Error fetching notifications:', e);
            }
        }

        // Auto-dismiss flash messages
        document.addEventListener('DOMContentLoaded', function() {
            const flashMessages = document.querySelectorAll('.flash-message');
            flashMessages.forEach((msg, index) => {
                setTimeout(() => {
                    msg.style.opacity = '0';
                    msg.style.transform = 'translateX(100%)';
                    setTimeout(() => msg.remove(), 300);
                }, 5000 + (index * 500));
            });
        });

        // Mobile sidebar toggle
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        }

        // Update notifications every 30 seconds
        setInterval(updateNotificationCount, 30000);
        updateNotificationCount();

        // Smooth page transitions
        document.querySelectorAll('a:not([target="_blank"])').forEach(link => {
            link.addEventListener('click', function(e) {
                if (this.hostname === window.location.hostname && !this.hash) {
                    e.preventDefault();
                    document.body.style.opacity = '0.5';
                    setTimeout(() => {
                        window.location = this.href;
                    }, 150);
                }
            });
        });
    </script>
</body>
</html>
