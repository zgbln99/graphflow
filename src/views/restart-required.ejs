<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <meta http-equiv="refresh" content="5">
</head>
<body class="bg-gradient-to-br from-indigo-100 via-purple-50 to-pink-100 min-h-screen">
    <div class="min-h-screen flex flex-col items-center justify-center py-12 px-4">
        <div class="w-full max-w-lg">
            <div class="text-center mb-8">
                <h1 class="text-4xl font-bold text-indigo-600"><%= appName %></h1>
                <p class="text-gray-600 mt-2">Panel Zlecen Graficznych</p>
            </div>

            <div class="bg-white rounded-xl shadow-xl overflow-hidden">
                <div class="p-8 text-center">
                    <div class="w-20 h-20 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-10 h-10 text-yellow-600 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                    </div>

                    <h2 class="text-2xl font-bold text-gray-900 mb-4">Wymagany restart serwera</h2>
                    <p class="text-gray-600 mb-6">
                        Instalacja zostala zakonczona pomyslnie, ale serwer musi zostac zrestartowany,
                        aby nowa konfiguracja zostala zaladowana.
                    </p>

                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6 text-left">
                        <div class="flex">
                            <svg class="w-5 h-5 text-blue-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <div class="text-sm text-blue-800">
                                <strong>Hostinger:</strong> Przejdz do panelu hostingu i zrestartuj aplikacje Node.js w sekcji "Website" &rarr; "Node.js".
                            </div>
                        </div>
                    </div>

                    <p class="text-sm text-gray-500">
                        Ta strona odswiezy sie automatycznie co 5 sekund...
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
