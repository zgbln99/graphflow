<!-- Flash Messages Container -->
<div id="flash-container" class="fixed top-20 right-4 z-50 space-y-3 max-w-md">
    <% if (typeof error !== 'undefined' && error && error.length) { %>
        <% error.forEach(function(msg, index) { %>
        <div class="flash-message animate-slide-in-right bg-white border-l-4 border-red-500 rounded-xl shadow-lg p-4 flex items-start gap-3" style="animation-delay: <%= index * 100 %>ms">
            <div class="flex-shrink-0 w-10 h-10 bg-red-100 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900">Błąd</p>
                <p class="text-sm text-gray-600 mt-0.5"><%= msg %></p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 p-1 rounded-lg hover:bg-gray-100 transition-colors">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <% }); %>
    <% } %>

    <% if (typeof success !== 'undefined' && success && success.length) { %>
        <% success.forEach(function(msg, index) { %>
        <div class="flash-message animate-slide-in-right bg-white border-l-4 border-emerald-500 rounded-xl shadow-lg p-4 flex items-start gap-3" style="animation-delay: <%= index * 100 %>ms">
            <div class="flex-shrink-0 w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900">Sukces</p>
                <p class="text-sm text-gray-600 mt-0.5"><%= msg %></p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 p-1 rounded-lg hover:bg-gray-100 transition-colors">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <% }); %>
    <% } %>

    <% if (typeof warning !== 'undefined' && warning && warning.length) { %>
        <% warning.forEach(function(msg, index) { %>
        <div class="flash-message animate-slide-in-right bg-white border-l-4 border-amber-500 rounded-xl shadow-lg p-4 flex items-start gap-3" style="animation-delay: <%= index * 100 %>ms">
            <div class="flex-shrink-0 w-10 h-10 bg-amber-100 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900">Uwaga</p>
                <p class="text-sm text-gray-600 mt-0.5"><%= msg %></p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 p-1 rounded-lg hover:bg-gray-100 transition-colors">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <% }); %>
    <% } %>

    <% if (typeof info !== 'undefined' && info && info.length) { %>
        <% info.forEach(function(msg, index) { %>
        <div class="flash-message animate-slide-in-right bg-white border-l-4 border-blue-500 rounded-xl shadow-lg p-4 flex items-start gap-3" style="animation-delay: <%= index * 100 %>ms">
            <div class="flex-shrink-0 w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900">Informacja</p>
                <p class="text-sm text-gray-600 mt-0.5"><%= msg %></p>
            </div>
            <button onclick="this.parentElement.remove()" class="flex-shrink-0 p-1 rounded-lg hover:bg-gray-100 transition-colors">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <% }); %>
    <% } %>
</div>
