<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>Logowanie — ZASTAL MARKETING CENTER</title>
  <link rel="stylesheet" href="/club/styles.css">
</head>
<body class="auth-body">
  <main class="login-shell">
    <section class="login-visual" aria-hidden="true">
      <div class="login-noise"></div>
      <div class="court-lines">
        <span class="court-circle"></span>
        <span class="court-line-v"></span>
        <span class="court-arc"></span>
      </div>
      <div class="login-brand-large">
        <div class="brand-mark brand-mark-xl">Z</div>
        <div>
          <strong>ZASTAL</strong>
          <span>MARKETING CENTER</span>
        </div>
      </div>
      <div class="login-hero-copy">
        <span class="login-kicker">CENTRUM MEDIALNE KLUBU</span>
        <h1>Grafiki. Zdjęcia.<br>Jeden workflow.</h1>
        <p>Wszystkie materiały meczowe i klubowe w jednym miejscu — gotowe do pracy w kilka sekund.</p>
      </div>
      <div class="login-status"><span></span> System wewnętrzny</div>
    </section>

    <section class="login-panel">
      <div class="login-card">
        <div class="login-mobile-brand">
          <div class="brand-mark">Z</div>
          <div><strong>ZASTAL</strong><span>MARKETING CENTER</span></div>
        </div>
        <div class="login-heading">
          <span class="login-kicker">WITAJ PONOWNIE</span>
          <h2>Zaloguj się</h2>
          <p>Użyj swojego konta ZASTAL Marketing Center.</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="auth-error"><span>!</span><div><strong>Nie udało się zalogować</strong><br><%= error %></div></div>
        <% } %>

        <form class="login-form" action="/login" method="post">
          <label>
            <span>Adres e-mail</span>
            <div class="input-shell">
              <span class="input-icon">@</span>
              <input type="email" name="email" autocomplete="email" placeholder="twoj@zastal.pl" required autofocus>
            </div>
          </label>
          <label>
            <span>Hasło</span>
            <div class="input-shell">
              <span class="input-icon">••</span>
              <input type="password" name="password" autocomplete="current-password" placeholder="Wpisz hasło" required>
            </div>
          </label>
          <button class="login-submit" type="submit">Zaloguj się <span>→</span></button>
        </form>

        <div class="login-footnote">Dostęp wyłącznie dla uprawnionych użytkowników klubu.</div>
      </div>
    </section>
  </main>
</body>
</html>
