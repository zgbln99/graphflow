# Pliki wgrywane przez użytkowników (logo klubu, overlaye szablonów, zdjęcia).
# Wzorzec ze slashem jest zakotwiczony w katalogu .gitignore, więc samo
# "uploads/*" nie obejmowało public/uploads — stąd jawna ścieżka.
/public/uploads/**
!/public/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Zależności
node_modules/
