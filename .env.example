# Konfiguracja bazy danych
DB_HOST=localhost
DB_NAME=zastal_marketing_center
DB_USER=zmc_user
DB_PASS=ustaw_silne_haslo
DB_PORT=3306

# Konfiguracja aplikacji
APP_NAME=ZASTAL MARKETING CENTER
APP_URL=http://localhost:3000
APP_PORT=3000
NODE_ENV=development

# Sesja
SESSION_SECRET=zmien_ten_klucz_na_losowy_ciag_znakow_32_znaki!

# Konfiguracja mailowa (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@example.com
MAIL_PASS=password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=GraphFlow Panel

# Strefa czasowa
TZ=Europe/Warsaw

# Monitoring Facebooka (wyłącznie po stronie serwera)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
SOCIAL_CACHE_TTL_MS=300000
SOCIAL_REQUEST_TIMEOUT_MS=15000
SOCIAL_MONITOR_INTERVAL_MS=900000
SOCIAL_AUTO_ANALYZE=false

# Analiza OpenAI (wyłącznie po stronie serwera)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Magazyn zdjęć — MEGA S4 (API zgodne z S3). Klucze generuje właściciel
# w panelu MEGA S4 (Object Storage → Access keys) i wpisuje WYŁĄCZNIE
# w /opt/club-graphics/.env na VPS. Nigdy w repozytorium.
S3_ENDPOINT=https://s3.eu-luxembourg-1.megas4.com
S3_REGION=eu-luxembourg-1
S3_BUCKET=zastal
S3_ACCESS_KEY=
S3_SECRET_KEY=
# path-style: https://s3.eu-luxembourg-1.megas4.com/zastal/klucz
# virtual-hosted (S3_FORCE_PATH_STYLE=false): https://zastal.s3.g.megas4.com/klucz
S3_FORCE_PATH_STYLE=true
# Czas ważności podpisanych adresów podglądu (sekundy)
S3_DOWNLOAD_URL_TTL=3600
