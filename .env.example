# ===========================================
# GraphFlow - Konfiguracja środowiska
# ===========================================

# Baza danych PostgreSQL
DATABASE_URL="postgresql://graphflow:graphflow@localhost:5432/graphflow?schema=public"

# Aplikacja
NEXT_PUBLIC_APP_URL="https://graphflow.eu"
APP_SECRET="wygeneruj-losowy-klucz-minimum-32-znakow"

# JWT
JWT_SECRET="wygeneruj-losowy-klucz-jwt-minimum-32-znakow"
JWT_EXPIRES_IN="7d"

# ===========================================
# SMTP (wysyłka maili)
# ===========================================
SMTP_HOST="mail.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="marek@graphflow.eu"
SMTP_PASS="twoje-haslo-smtp"
SMTP_FROM_NAME="GraphFlow"
SMTP_FROM_EMAIL="no-reply@graphflow.eu"

# ===========================================
# IMAP (odbieranie maili)
# ===========================================
IMAP_HOST="imap.hostinger.com"
IMAP_PORT="993"
IMAP_USER="marek@graphflow.eu"
IMAP_PASS="twoje-haslo-imap"
IMAP_TLS="true"
IMAP_MAILBOX="INBOX"

# Sekret do podpisywania Reply-To tokenów (HMAC)
EMAIL_REPLY_SECRET="wygeneruj-losowy-klucz-hmac-minimum-32-znakow"

# Domena do Reply-To
EMAIL_REPLY_DOMAIN="graphflow.eu"

# Interwał pollingu (w milisekundach) - domyślnie 60000 (1 minuta)
EMAIL_POLL_INTERVAL="60000"

# ===========================================
# Redis (opcjonalnie - dla BullMQ)
# ===========================================
# REDIS_URL="redis://localhost:6379"

# ===========================================
# Dropbox (opcjonalnie)
# ===========================================
# DROPBOX_ACCESS_TOKEN=""
# DROPBOX_ROOT_PATH="/GraphFlow"
